{
  "version": 2,
  "meta": {
    "id": "sa8397-hab-architecture",
    "title": "SA8397 HAB Communication Architecture",
    "subtitle": "Virtio / vhost transport across Linux PVM and Android GVM",
    "description": "HAB architecture across the Linux PVM and Android GVM. PVM HAB client APIs and virtual-device configuration services are parallel branches. The user HAB API is shown in the confirmed display backend process. Three GVM drivers call KHAB. A Gunyah Virtio-MMIO virtual-device resource handles queue events and Guest vIRQ assertion. Hypervisor internals are represented at the ABI-backed functional level, not as unverified source modules. Business buffer export/import and standalone HAB VIRQ are outside this view.",
    "scope": "system",
    "view": "layered",
    "colorMode": "technical"
  },
  "canvas": {
    "width": 2852,
    "height": 2610
  },

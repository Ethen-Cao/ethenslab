  "meta": {
    "id": "gvm-watchdog-architecture",
    "title": "GVM Watchdog Architecture",
    "subtitle": "Kernel petting, virtual bark / bite and managed GVM restart",
    "description": "The QNX primary host context and Android guest are shown above the common QNX Hypervisor band. qvm is a QNX host process, with vdev-msm.so as its real watchdog implementation. Guest MMIO, virtual bark IRQ, event 3, lifecycle restart policy, process spawning and guest-minidump collection are distinct relations. Physical host watchdog and debug host-ramdump override are omitted.",
    "scope": "subsystem",
    "view": "layered",
    "colorMode": "technical"
  },

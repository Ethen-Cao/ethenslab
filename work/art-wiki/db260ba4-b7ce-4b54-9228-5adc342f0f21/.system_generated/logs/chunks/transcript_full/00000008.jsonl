ass JitOptions;\n62: \n63: static constexpr int16_t kJitCheckForOSR = -1;\n64: static constexpr int16_t kJitHotnessDisabled = -2;\n65: \n66: // The frequency at which we are going to check if we want to do fast\n67: // compilation. Only the main thread will request fast compilations.\n68: static constexpr int16_t kFastCompilerFrequencyCheck = 1024;\n69: static_assert(IsPowerOfTwo(kFastCompilerFrequencyCheck), \"Must be a power of two\");\n70: \n71: // Implemented and provided by the compiler library.\n72: class JitCompilerInterface {\n73:  public:\n74:   virtual ~JitCompilerInterface() {}\n75:   virtual bool CompileMethod(\n76:       Thread* self, JitMemoryRegion* region, ArtMethod* method, CompilationKind compilation_kind)\n77:       REQUIRES_SHARED(Locks::mutator_lock_) = 0;\n78:   virtual void TypesLoaded(mirror::Class**, size_t count)\n79:       REQUIRES_SHARED(Locks::mutator_lock_) = 0;\n80:   virtual bool GenerateDebugInfo() = 0;\n81:   virtual void ParseCompilerOptions() = 0;\n82:   virtual bool IsBaselineCompiler() const = 0;\n83:   virtual void SetDebuggableCompilerOption(bool value) = 0;\n84:   virtual uint32_t GetInlineMaxCodeUnits() const = 0;\n85: \n86:   virtual std::vector<uint8_t> PackElfFileForJIT(ArrayRef<const JITCodeEntry*> elf_files,\n87:                                                  ArrayRef<const void*> removed_symbols,\n88:                                                  bool compress,\n89:                                                  /*out*/ size_t* num_symbols) = 0;\n90: };\n91: \n92: // Data structure holding information to perform an OSR.\n93: struct OsrData {\n94:   // The native PC to jump to.\n95:   const uint8_t* native_pc;\n96: \n97:   // The frame size of the compiled code to jump to.\n98:   size_t frame_size;\n99: \n100:   // The dynamically allocated memory of size `frame_size` to copy to stack.\n101:   void* memory[0];\n102: \n103:   static constexpr MemberOffset NativePcOffset() {\n104:     return MemberOffset(OFFSETOF_MEMBER(OsrData, native_pc));\n105:   }\n106: \n107:   static constexpr MemberOffset FrameSizeOffset() {\n108:     return MemberOffset(OFFSETOF_MEMBER(OsrData, frame_size));\n109:   }\n110: \n111:   static constexpr MemberOffset MemoryOffset() {\n112:     return MemberOffset(OFFSETOF_MEMBER(OsrData, memory));\n113:   }\n114: };\n115: \n116: /**\n117:  * A customized thread pool for the JIT, to prioritize compilation kinds, and\n118:  * simplify root visiting.\n119:  */\n120: class JitThreadPool : public AbstractThreadPool {\n121:  public:\n122:   static JitThreadPool* Create(const char* name,\n123:                                size_t num_threads,\n124:                                size_t worker_stack_size = ThreadPoolWorker::kDefaultStackSize) {\n125:     JitThreadPool* pool = new JitThreadPool(name, num_threads, worker_stack_size);\n126:     pool->CreateThreads();\n127:     return pool;\n128:   }\n129: \n130:   // Add a task to the generic queue. This is for tasks like\n131:   // ZygoteVerificationTask, or JitCompileTask for precompile.\n132:   void AddTask(Thread* self, Task* task) REQUIRES(!task_queue_lock_) override;\n133:   size_t GetTaskCount(Thread* self) REQUIRES(!task_queue_lock_) override;\n134:   void RemoveAllTasks(Thread* self) REQUIRES(!task_queue_lock_) override;\n135:   ~JitThreadPool() override;\n136: \n137:   // Remove the task from the list of compiling tasks.\n138:   void Remove(JitCompileTask* task) REQUIRES(!task_queue_lock_);\n139: \n140:   // Add a custom compilation task in the right queue.\n141:   void AddTask(Thread* self, ArtMethod* method, CompilationKind kind) REQUIRES(!task_queue_lock_);\n142: \n143:   // Visit the ArtMethods stored in the various queues.\n144:   void VisitRoots(RootVisitor* visitor);\n145: \n146:  protected:\n147:   Task* TryGetTaskLocked() REQUIRES(task_queue_lock_) override;\n148: \n149:   bool HasOutstandingTasks() const REQUIRES(task_queue_lock_) override {\n150:     return started_ &&\n151:         (!generic_queue_.empty() ||\n152:          !baseline_queue_.empty() ||\n153:          !optimized_queue_.empty() ||\n154:          !osr_queue_.empty());\n155:   }\n156: \n157:  private:\n158:   JitThreadPool(const char* name,\n159:                 size_t num_threads,\n160:                 size_t worker_stack_size)\n161:       // We need peers as JIT thread can load classes and we may report related events b/29547798.\n162:       : AbstractThreadPool(name, num_threads, /* create_peers= */ true, worker_stack_size) {}\n163: \n164:   // Try to fetch an entry from `methods`. Return null if `methods` is empty.\n165:   Task* FetchFrom(std::deque<ArtMethod*>& methods, CompilationKind kind) REQUIRES(task_queue_lock_);\n166: \n167:   std::deque<Task*> generic_queue_ GUARDED_BY(task_queue_lock_);\n168: \n169:   std::deque<ArtMethod*> osr_queue_ GUARDED_BY(task_queue_lock_);\n170:   std::deque<ArtMethod*> fast_queue_ GUARDED_BY(task_queue_lock_);\n171:   std::deque<ArtMethod*> baseline_queue_ GUARDED_BY(task_queue_lock_);\n172:   std::deque<ArtMethod*> optimized_queue_ GUARDED_BY(task_queue_lock_);\n173: \n174:   // We track the methods that are currently enqueued to avoid\n175:   // adding them to the queue multiple times, which could bloat the\n176:   // queues.\n177:   std::set<ArtMethod*> osr_enqueued_methods_ GUARDED_BY(task_queue_lock_);\n178:   std::set<ArtMethod*> fast_enqueued_methods_ GUARDED_BY(task_queue_lock_);\n179:   std::set<ArtMethod*> baseline_enqueued_methods_ GUARDED_BY(task_queue_lock_);\n180:   std::set<ArtMethod*> optimized_enqueued_methods_ GUARDED_BY(task_queue_lock_);"}

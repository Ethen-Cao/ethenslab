                     jboolean countAssignable) {\n389:   ScopedObjectAccess soa(env);\n390:   gc::Heap* const heap = Runtime::Current()->GetHeap();\n391:   // Caller's responsibility to do GC if desired.\n392:   ObjPtr<mirror::ObjectArray<mirror::Class>> decoded_classes =\n393:       soa.Decode<mirror::ObjectArray<mirror::Class>>(javaClasses);\n394:   if (decoded_classes == nullptr) {\n395:     return nullptr;\n396:   }\n397:   VariableSizedHandleScope hs(soa.Self());\n398:   std::vector<Handle<mirror::Class>> classes;\n399:   for (size_t i = 0, count = decoded_classes->GetLength(); i < count; ++i) {\n400:     classes.push_back(hs.NewHandle(decoded_classes->Get(i)));\n401:   }\n402:   std::vector<uint64_t> counts(classes.size(), 0u);\n403:   // Heap::CountInstances can handle null and will put 0 for these classes.\n404:   heap->CountInstances(classes, countAssignable, &counts[0]);\n405:   ObjPtr<mirror::LongArray> long_counts = mirror::LongArray::Alloc(soa.Self(), counts.size());\n406:   if (long_counts == nullptr) {\n407:     soa.Self()->AssertPendingOOMException();\n408:     return nullptr;\n409:   }\n410:   for (size_t i = 0; i < counts.size(); ++i) {\n411:     long_counts->Set(i, counts[i]);\n412:   }\n413:   return soa.AddLocalReference<jlongArray>(long_counts);\n414: }\n415: \n416: // The runtime stat names for VMDebug.getRuntimeStat().\n417: enum class VMDebugRuntimeStatId {\n418:   kArtGcGcCount = 0,\n419:   kArtGcGcTime,\n420:   kArtGcBytesAllocated,\n421:   kArtGcBytesFreed,\n422:   kArtGcBlockingGcCount,\n423:   kArtGcBlockingGcTime,\n424:   kArtGcGcCountRateHistogram,\n425:   kArtGcBlockingGcCountRateHistogram,\n426:   kArtGcObjectsAllocated,\n427:   kArtGcTotalTimeWaitingForGc,\n428:   kArtGcPreOomeGcCount,\n429:   kNumRuntimeStats,\n430: };\n431: \n432: static jstring VMDebug_getRuntimeStatInternal(JNIEnv* env, jclass, jint statId) {\n433:   gc::Heap* heap = Runtime::Current()->GetHeap();\n434:   switch (static_cast<VMDebugRuntimeStatId>(statId)) {\n435:     case VMDebugRuntimeStatId::kArtGcGcCount: {\n436:       std::string output = std::to_string(heap->GetGcCount());\n437:       return env->NewStringUTF(output.c_str());\n438:     }\n439:     case VMDebugRuntimeStatId::kArtGcGcTime: {\n440:       std::string output = std::to_string(NsToMs(heap->GetGcTime()));\n441:       return env->NewStringUTF(output.c_str());\n442:     }\n443:     case VMDebugRuntimeStatId::kArtGcBytesAllocated: {\n444:       std::string output = std::to_string(heap->GetBytesAllocatedEver());\n445:       return env->NewStringUTF(output.c_str());\n446:     }\n447:     case VMDebugRuntimeStatId::kArtGcBytesFreed: {\n448:       std::string output = std::to_string(heap->GetBytesFreedEver());\n449:       return env->NewStringUTF(output.c_str());\n450:     }\n451:     case VMDebugRuntimeStatId::kArtGcBlockingGcCount: {\n452:       std::string output = std::to_string(heap->GetBlockingGcCount());\n453:       return env->NewStringUTF(output.c_str());\n454:     }\n455:     case VMDebugRuntimeStatId::kArtGcBlockingGcTime: {\n456:       std::string output = std::to_string(NsToMs(heap->GetBlockingGcTime()));\n457:       return env->NewStringUTF(output.c_str());\n458:     }\n459:     case VMDebugRuntimeStatId::kArtGcGcCountRateHistogram: {\n460:       std::ostringstream output;\n461:       heap->DumpGcCountRateHistogram(output);\n462:       return env->NewStringUTF(output.str().c_str());\n463:     }\n464:     case VMDebugRuntimeStatId::kArtGcBlockingGcCountRateHistogram: {\n465:       std::ostringstream output;\n466:       heap->DumpBlockingGcCountRateHistogram(output);\n467:       return env->NewStringUTF(output.str().c_str());\n468:     }\n469:     case VMDebugRuntimeStatId::kArtGcObjectsAllocated: {\n470:       std::string output = std::to_string(heap->GetObjectsAllocated());\n471:       return env->NewStringUTF(output.c_str());\n472:     }\n473:     case VMDebugRuntimeStatId::kArtGcTotalTimeWaitingForGc: {\n474:       std::string output = std::to_string(heap->GetTotalTimeWaitingForGC());\n475:       return env->NewStringUTF(output.c_str());\n476:     }\n477:     case VMDebugRuntimeStatId::kArtGcPreOomeGcCount: {\n478:       std::string output = std::to_string(heap->GetPreOomeGcCount());\n479:       return env->NewStringUTF(output.c_str());\n480:     }\n481:     default:\n482:       return nullptr;\n483:   }\n484: }\n485: \n486: static bool SetRuntimeStatValue(Thread* self,\n487:                                 Handle<mirror::ObjectArray<mirror::String>> array,\n488:                                 VMDebugRuntimeStatId id,\n489:                                 const std::string& value) REQUIRES_SHARED(Locks::mutator_lock_) {\n490:   ObjPtr<mirror::String> ovalue = mirror::String::AllocFromModifiedUtf8(self, value.c_str());\n491:   if (ovalue == nullptr) {\n492:     DCHECK(self->IsExceptionPending());\n493:     return false;\n494:   }\n495:   // We're initializing a newly allocated array object, so we do not need to record that under\n496:   // a transaction. If the transaction is aborted, the whole object shall be unreachable.\n497:   array->SetWithoutChecks</*kTransactionActive=*/ false, /*kCheckTransaction=*/ false>(\n498:       static_cast<int32_t>(id), ovalue);\n499:   return true;\n500: }"}

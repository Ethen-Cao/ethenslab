count;\n108:   // Cumulative time spent in class initialization.\n109:   uint64_t class_init_time_ns;\n110: \n111:   DISALLOW_COPY_AND_ASSIGN(RuntimeStats);\n112: };\n113: \n114: }  // namespace art\n115: \n116: #endif  // ART_RUNTIME_RUNTIME_STATS_H_"}

a.util.function.Function;\n47: import java.util.stream.Collectors;\n48: \n49: /**\n50:  * A helper class to handle dump.\n51:  *\n52:  * @hide\n53:  */\n54: @RequiresApi(Build.VERSION_CODES.UPSIDE_DOWN_CAKE)\n55: public class DumpHelper {\n56:     @NonNull private final Injector mInjector;\n57: \n58:     public DumpHelper(@NonNull ArtManagerLocal artManagerLocal) {\n59:         this(new Injector(artManagerLocal));\n60:     }\n61: \n62:     @VisibleForTesting\n63:     public DumpHelper(@NonNull Injector injector) {\n64:         mInjector = injector;\n65:     }\n66: \n67:     /** Handles {@link ArtManagerLocal#dump(PrintWriter, PackageManagerLocal.FilteredSnapshot)}. */\n68:     public void dump(\n69:             @NonNull PrintWriter pw, @NonNull PackageManagerLocal.FilteredSnapshot snapshot) {\n70:         snapshot.getPackageStates()\n71:                 .values()\n72:                 .stream()\n73:                 .sorted(Comparator.comparing(PackageState::getPackageName))\n74:                 .forEach(pkgState -> dumpPackage(pw, snapshot, pkgState));\n75:         pw.printf(\"\\nCurrent GC: %s\\n\", ArtJni.getGarbageCollector());\n76:     }\n77: \n78:     /**\n79:      * Handles {@link\n80:      * ArtManagerLocal#dumpPackage(PrintWriter, PackageManagerLocal.FilteredSnapshot, String)}.\n81:      */\n82:     public void dumpPackage(@NonNull PrintWriter pw,\n83:             @NonNull PackageManagerLocal.FilteredSnapshot snapshot,\n84:             @NonNull PackageState pkgState) {\n85:         if (pkgState.isApex() || pkgState.getAndroidPackage() == null) {\n86:             return;\n87:         }\n88: \n89:         var ipw = new IndentingPrintWriter(pw);\n90: \n91:         String packageName = pkgState.getPackageName();\n92:         ipw.printf(\"[%s]\\n\", packageName);\n93: \n94:         List<DexContainerFileDexoptStatus> statuses =\n95:                 mInjector.getArtManagerLocal()\n96:                         .getDexoptStatus(snapshot, packageName)\n97:                         .getDexContainerFileDexoptStatuses();\n98:         Map<String, CheckedSecondaryDexInfo> secondaryDexInfoByDexPath =\n99:                 mInjector.getDexUseManager()\n100:                         .getCheckedSecondaryDexInfo(\n101:                                 packageName, false /* excludeObsoleteDexesAndLoaders */)\n102:                         .stream()\n103:                         .collect(Collectors.toMap(\n104:                                 CheckedSecondaryDexInfo::dexPath, Function.identity()));\n105: \n106:         // Use LinkedHashMap to keep the order. They are ordered by their split indexes.\n107:         var primaryStatusesByDexPath =\n108:                 new LinkedHashMap<String, List<DexContainerFileDexoptStatus>>();\n109:         // Use TreeMap to force lexicographical order.\n110:         var secondaryStatusesByDexPath = new TreeMap<String, List<DexContainerFileDexoptStatus>>();\n111:         for (DexContainerFileDexoptStatus fileStatus : statuses) {\n112:             if (fileStatus.isPrimaryDex()) {\n113:                 primaryStatusesByDexPath\n114:                         .computeIfAbsent(fileStatus.getDexContainerFile(), k -> new ArrayList<>())\n115:                         .add(fileStatus);\n116:             } else if (secondaryDexInfoByDexPath.containsKey(fileStatus.getDexContainerFile())) {\n117:                 // The condition above is false only if a change occurs between\n118:                 // `getDexoptStatus` and `getSecondaryDexInfo`, which is an edge case.\n119:                 secondaryStatusesByDexPath\n120:                         .computeIfAbsent(fileStatus.getDexContainerFile(), k -> new ArrayList<>())\n121:                         .add(fileStatus);\n122:             }\n123:         }\n124: \n125:         ipw.increaseIndent();\n126:         for (List<DexContainerFileDexoptStatus> fileStatuses : primaryStatusesByDexPath.values()) {\n127:             dumpPrimaryDex(ipw, snapshot, fileStatuses, packageName);\n128:         }\n129:         if (!secondaryStatusesByDexPath.isEmpty()) {\n130:             ipw.println(\"known secondary dex files:\");\n131:             ipw.increaseIndent();\n132:             for (Map.Entry<String, List<DexContainerFileDexoptStatus>> entry :\n133:                     secondaryStatusesByDexPath.entrySet()) {\n134:                 dumpSecondaryDex(ipw, snapshot, entry.getValue(), packageName,\n135:                         secondaryDexInfoByDexPath.get(entry.getKey()));\n136:             }\n137:             ipw.decreaseIndent();\n138:         }\n139:         ipw.decreaseIndent();\n140:     }"}

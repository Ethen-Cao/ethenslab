t* siginfo, void* context) override NO_THREAD_SAFETY_ANALYSIS;\n218:   constexpr static bool IsGeneratedCodeHandler() { return false; }\n219: \n220:  private:\n221:   FaultManager* manager_;\n222: \n223:   DISALLOW_COPY_AND_ASSIGN(JavaStackTraceHandler);\n224: };\n225: \n226: // Statically allocated so the the signal handler can Get access to it.\n227: EXPORT extern FaultManager fault_manager;\n228: \n229: }  // namespace art\n230: #endif  // ART_RUNTIME_FAULT_HANDLER_H_\n231: "}

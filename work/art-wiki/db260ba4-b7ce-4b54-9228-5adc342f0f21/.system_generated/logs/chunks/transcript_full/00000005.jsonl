e->NotifyStartupCompleted()) {\n50:     // Maybe generate a runtime app image. If the runtime is debuggable, boot\n51:     // classpath classes can be dynamically changed, so don't bother generating an\n52:     // image.\n53:     if (!runtime->IsJavaDebuggable()) {\n54:       std::string compiler_filter;\n55:       std::string compilation_reason;\n56:       std::string primary_apk_path = runtime->GetAppInfo()->GetPrimaryApkPath();\n57:       runtime->GetAppInfo()->GetPrimaryApkOptimizationStatus(&compiler_filter, &compilation_reason);\n58:       CompilerFilter::Filter filter;\n59:       if (CompilerFilter::ParseCompilerFilter(compiler_filter.c_str(), &filter) &&\n60:           !CompilerFilter::IsAotCompilationEnabled(filter) &&\n61:           !runtime->GetHeap()->HasAppImageSpaceFor(primary_apk_path)) {\n62:         std::string error_msg;\n63:         if (!RuntimeImage::WriteImageToDisk(&error_msg)) {\n64:           LOG(DEBUG) << \"Could not write temporary image to disk \" << error_msg;\n65:         }\n66:       }\n67:     }\n68: \n69:     ScopedObjectAccess soa(self);\n70:     DeleteStartupDexCaches(self, /* called_by_gc= */ false);\n71:   }\n72: \n73:   // Delete the thread pool used for app image loading since startup is assumed to be completed.\n74:   ScopedTrace trace2(\"Delete thread pool\");\n75:   Runtime::Current()->DeleteThreadPool();\n76: }\n77: \n78: void StartupCompletedTask::DeleteStartupDexCaches(Thread* self, bool called_by_gc) {\n79:   VLOG(startup) << \"StartupCompletedTask running\";\n80:   Runtime* const runtime = Runtime::Current();\n81: \n82:   ScopedTrace trace(\"Releasing dex caches and app image spaces metadata\");\n83: \n84:   static struct EmptyClosure : Closure {\n85:     void Run([[maybe_unused]] Thread* thread) override {}\n86:   } closure;\n87: \n88:   // Fetch the startup linear alloc so no other thread tries to allocate there.\n89:   std::unique_ptr<LinearAlloc> startup_linear_alloc(runtime->ReleaseStartupLinearAlloc());\n90:   // No thread could be allocating arrays or accessing dex caches when this\n91:   // thread has mutator-lock held exclusively.\n92:   bool run_checkpoints = !Locks::mutator_lock_->IsExclusiveHeld(self);\n93: \n94:   // Request a checkpoint to make sure all threads see we have started up and\n95:   // won't allocate in the startup linear alloc. Without this checkpoint what\n96:   // could happen is (T0 == self):\n97:   // 1) T1 fetches startup alloc, allocates an array there.\n98:   // 2) T0 goes over the dex caches, clear dex cache arrays in the startup alloc.\n99:   // 3) T1 sets the dex cache array from startup alloc in a dex cache.\n100:   // 4) T0 releases startup alloc.\n101:   //\n102:   // With this checkpoint, 3) cannot happen as T0 waits for T1 to reach the\n103:   // checkpoint.\n104:   if (run_checkpoints) {\n105:     runtime->GetThreadList()->RunCheckpoint(&closure);\n106:   }\n107: \n108:   {\n109:     UnlinkStartupDexCacheVisitor visitor;\n110:     ReaderMutexLock mu(self, *Locks::dex_lock_);\n111:     runtime->GetClassLinker()->VisitDexCaches(&visitor);\n112:   }\n113: \n114: \n115:   // Request a checkpoint to make sure no threads are:\n116:   // - accessing the image space metadata section when we madvise it\n117:   // - accessing dex caches when we free them\n118:   if (run_checkpoints) {\n119:     runtime->GetThreadList()->RunCheckpoint(&closure);\n120:   }"}
{"step_index":138,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-26T01:31:18Z","input_tokens":6177,"cache_read_tokens":221512,"output_tokens":16894,"content":"基于对 [art](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art) 目录源码的核查，该仓库对应 **Android 15/16 主线级 ART 模块**（[palette_method_list.h](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/libartpalette/include/palette/palette_method_list.h#L80-L104) 已演进至 SDK 36.1 接口，[art-flags.aconfig](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/build/flags/art-flags.aconfig#L110-L117) 包含 `art_service_v3`）。其运行时与编译器核心保持**标准上游 AOSP 实现**，未内置高通 `perf_lock` 或车机私有业务插桩（平台侧扩展统一通过 [`libartpalette`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/libartpalette/include/palette/palette_method_list.h#L28-L104) 桥接）。\n\nART 在源码层面围绕 **App 性能** 与 **App 稳定性** 构建了完整的监测、采样、告警与故障取证体系，具体实现如下：\n\n---\n\n## 一、 App 性能监测机制（Performance Monitoring）\n\n### 1. 运行时遥测指标体系（ART Metrics -> Statsd / Logcat / File）\n* **采集指标（48 项）**：[`metrics.h`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/libartbase/base/metrics/metrics.h#L43-L98) 定义了 28 项事件指标（`ART_EVENT_METRICS`）与 20 项周期增量指标（`ART_VALUE_METRICS`），覆盖：\n  * **类加载与校验**：`ClassLoadingTotalTime`、`ClassVerificationCount`、`ClassVerificationTotalTime`。\n  * **JIT 编译**：`JitMethodCompileCount`、`JitMethodCompileTotalTime`。\n  * **GC 吞吐与停顿**：STW 停顿均值/总计（`WorldStopTimeDuringGCAvg`、`GcWorldStopTime`、`GcWorldStopCount`）、Young/Full GC 次数、耗时直方图、扫描/释放字节数、吞吐率，以及并发 GC 期间业务线程慢路径耗时（`AppSlowPathDuringYoungGcDurationDelta` / `AppSlowPathDuringFullGcDurationDelta`）。\n* **采样与上报**：[`MetricsReporter`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/metrics/reporter.cc#L57-L198) 以后台守护线程运行，受 [`Flags`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/libartbase/base/flags.h#L266-L317)（`dalvik.vm.metrics.*` / `persist.device_config.runtime_native.metrics.*`）控制，默认对 **2%** 会话采样，在 **App 启动完成**（[`NotifyStartupCompleted`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/metrics/reporter.cc#L83-L87)）、**周期定时器**（App 默认 `1,5,30,60,600` 秒）及**进程退出**时，关联主 APK 的编译过滤器与 [`CompilationReason`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/libartbase/base/metrics/metrics.h#L173-L177)，通过 [`statsd.cc`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/metrics/statsd.cc#L46-L95) 写入 `ART_DATUM_REPORTED` 与 `ART_DATUM_DELTA_REPORTED`，也可输出至 Logcat 或 XML/文本文件。\n\n### 2. GC 停顿、内存分配阻塞与卡顿（Jank）监测\n* **慢 GC 与长停顿日志**：[`Heap::LogGC`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/gc/heap.cc#L2968-L3012) 在前台可感知状态（[`Heap::CareAboutPauseTimes`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/gc/heap.cc#L231-L233)）下监测：\n  * 单次 STW 停顿 `>=` **5ms**（[`kDefaultLongPauseLogThreshold`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/gc/heap.h#L146)，`-XX:LongPauseLogThreshold`）、分配触发 GC 总耗时 `>` **5ms**、总 GC 耗时 `>` **100ms**（[`kDefaultLongGCLogThreshold`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/gc/heap.h#L148)，`-XX:LongGCLogThreshold`）或显式 `System.gc()` 时，输出回收字节、堆利用率与各阶段停顿明细。\n  * **阻塞等待告警**：业务线程分配阻塞 [`Heap::WaitForGcToCompleteLocked`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/gc/heap.cc#L3713-L3751)、JNI Critical 区等待线程翻转 [`Heap::IncrementDisableThreadFlip`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/gc/heap.cc#L1019-L1049) 及 [`Heap::ThreadFlipBegin`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/gc/heap.cc#L1084-L1107) 超过 **5ms** 均会打印阻塞日志。\n* **弱引用访问阻塞告警**：[`ReferenceProcessor::GetReferent`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/gc/reference_processor.cc#L92-L166) 在 `Reference.get()` 因并发引用处理被阻塞时记录 ATrace `\"GetReferent blocked\"`，若阻塞超过 **10ms**（`kReportMillis`）输出 `WARNING` 日志。\n* **GC 直方图与 `Debug.getRuntimeStat` 接口**：[`Heap::UpdateGcCountRateHistograms`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/gc/heap.cc#L3014-L3079) 按 10s 窗口统计普通/阻塞 GC 速率直方图；[`VMDebug_getRuntimeStatInternal`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/native/dalvik_system_VMDebug.cc#L417-L484) 暴露 GC 次数/耗时、阻塞 GC 次数/耗时、等待 GC 总耗时及 **OOM 前抢救 GC 计数**（`art.gc.pre-oome-gc-count`）。\n* **ATrace 全链路切片与缺页监测**：[`TimingLogger::StartTiming`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/base/timing_logger.cc#L139-L148) 自动将所有 GC 子阶段转为 Systrace slice；[`MarkCompact::TraceFaults`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/gc/collector/mark_compact.cc#L858-L870) 通过 `getrusage` 上报 GC 期间次/主缺页中断 `Minflt-GC` / `Majflt-GC`（反映 ZRAM/磁盘换入延迟）；[`Heap::TraceHeapSize`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/gc/heap.cc#L2745-L2747) 实时上报 `\"Heap size (KB)\"`。\n* **Native 内存水位监测与节流**：[`Heap::RegisterNativeAllocation`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/gc/heap.cc#L4476-L4488) 与 [`Heap::CheckGCForNative`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/gc/heap.cc#L4430-L4465) 汇总 `mallinfo()` 与 `NativeAllocationRegistry` 内存计算 `gc_urgency`，超阈值触发并发 Full GC，严重超限（`gc_urgency > 4.0` 且超 `-XX:StopForNativeAllocs`）时阻塞分配线程并告警。\n\n### 3. Java 堆采样与内存泄漏剖析（Perfetto & HPROF）\n* **Perfetto 持续堆分配采样（`heapprofd`）**：[`HeapSampler`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/javaheapprof/javaheapsampler.h#L31-L95)（[javaheapsampler.cc](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/javaheapprof/javaheapsampler.cc#L28-L72)，`-XX:PerfettoJavaHeapStackProf=true`）注册 `\"com.android.art\"` 数据源，默认以 **4KB** 采样步长按指数分布动态缩小 TLAB，在 TLAB 重填及大对象/Native 内存注册处向 `heapprofd` 上报分配调用栈，不牺牲内联快路径性能。\n* **Perfetto 双 Fork 低停顿堆转储（`android.java_hprof`）**：[`perfetto_hprof.cc`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/perfetto_hprof/perfetto_hprof.cc#L1059-L1200) 监听 `__SIGRTMIN + 6` 信号，挂起线程后 `fork` 并立即恢复父进程运行（避免传统 HPROF 秒级冻结 App），由独立孙进程（内置 **120s** `SIGKILL` 看门狗）遍历对象引用图、关联 `NativeAllocationRegistry` 大小及 `/proc/self/smaps` 流式写入 Perfetto。\n* **传统分配追踪与 HPROF**：[`AllocRecordObjectMap`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/gc/allocation_record.cc#L157-L264)（记录最近 64K 分配及调用栈）与同步堆转储 [`hprof::DumpHeap`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/hprof/hprof.cc#L1616-L1627)。\n\n### 4. 方法追踪、采样剖析与低开销长耗时方法监测\n* **方法级追踪与 CPU 栈采样**：[`Trace`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/trace.h#L198-L210)（[trace.cc](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/trace.cc)）支持全量方法进出/异常展开追踪（支持 Wall / Thread CPU / Dual 双时钟及流式落盘）与周期性调用栈采样。\n* **低开销环形缓冲追踪（`TraceProfiler`）**：[`TraceProfiler`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/trace_profile.h#L172-L212)（[trace_profile.cc](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/trace_profile.cc#L112-L203)，受 `always_enable_profile_code` / `dalvik.vm.allow_profile_code` 控制）由编译代码直接向每线程 2048 槽无锁环形缓冲写入硬件计数器时间戳，支持全方法追踪与**长耗时方法捕获**（`kLongRunningMethods`，阈值 `1 << 23` ticks，约 **341ms**）。\n* **外部剖析器符号与偏移暴露**：[`debugger_interface.cc`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/jit/debugger_interface.cc#L186-L241) 通过 `__jit_debug_register_code` 与 `__dex_debug_register_code` 向 `simpleperf`、`perfetto` 和 `debuggerd` 实时同步内存 ELF 调试符号；[`VMDebug_getExecutableMethodFileOffsets`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/native/dalvik_system_VMDebug.cc#L350-L383) 返回 AOT 方法在 odex 中的精确偏移，支持 eBPF `uprobe` 挂载。\n\n### 5. 锁竞争监测（Lock Contention）与优先级反转保护\n* **胖锁竞争采样与多通道上报**：[`Monitor::Lock`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art
                                                                         \\\n55:     int32_t wait_ms,                                                                          \\\n56:     const char* filename,                                                                     \\\n57:     int32_t line_number,                                                                      \\\n58:     const char* method_name,                                                                  \\\n59:     const char* owner_filename,                                                               \\\n60:     int32_t owner_line_number,                                                                \\\n61:     const char* owner_method_name,                                                            \\\n62:     const char* proc_name,                                                                    \\\n63:     const char* thread_name)                                                                  \\\n64:                                                                                               \\\n65:   /* Introduced in version 3 API, corresponding to SDK level 34. */                           \\\n66:   /* Calls through to SetTaskProfiles in libprocessgroup to set the */                        \\\n67:   /* [task profile](https:/-/source.android.com/docs/core/perf/cgroups#task-profiles-file) */ \\\n68:   /* for the given thread id. */                                                              \\\n69:   /* */                                                                                       \\\n70:   /* @param tid The thread id. */                                                             \\\n71:   /* @param profiles An array of pointers to C strings that list the task profiles to set. */ \\\n72:   /* @param profiles_len The number of elements in profiles. */                               \\\n73:   /* @return PALETTE_STATUS_OK if the call succeeded. */                                      \\\n74:   /*         PALETTE_STATUS_FAILED_CHECK_LOG if it failed. */                                 \\\n75:   /*         PALETTE_STATUS_NOT_SUPPORTED if the implementation no longer supports this */    \\\n76:   /*         call. This can happen at any future SDK level since this function wraps an */    \\\n77:   /*         internal unstable API. */                                                        \\\n78:   M(PaletteSetTaskProfiles, int32_t tid, const char* const profiles[], size_t profiles_len)   \\\n79:                                                                                               \\\n80:   /* Introduced in version 4 API, corresponding to SDK level 36. */                           \\\n81:   /* Retrieves the debug store as a string. */                                                \\\n82:   /* */                                                                                       \\\n83:   /* This function retrieves debug information stored in a predefined debug store. */         \\\n84:   /* The information retrieved are used for debugging and logging purposes. */                \\\n85:   /* */                                                                                       \\\n86:   /* @param result  A pointer to a null-terminated character array where the retrieved */     \\\n87:   /*               string will be stored. */                                                  \\\n88:   /* @param max_size The maximum number of characters to be copied into the result, */        \\\n89:   /*                 including the null terminator. It is the caller's responsibility */      \\\n90:   /*                 to ensure that the pointed by result is large enough to store */         \\\n91:   /*                 up to max_size characters. */                                            \\\n92:   /* @return PALETTE_STATUS_OK if the call succeeded. */                                      \\\n93:   /*          PALETTE_STATUS_INVALID_ARGUMENT if the pointer is a nullptr or max_size is 0 */ \\\n94:   M(PaletteDebugStoreGetString, char* result, size_t max_size)                                \\\n95:                                                                                               \\\n96:   /* Introduced in version 5 API, corresponding to SDK level 36.1. */                         \\\n97:   /* Retrieve the nice value (as used by Posix setpriority()) corresponding to a managed */   \\\n98:   /* (Java) thread priority. */                                                               \\\n99:   /* */                                                                                       \\\n100:   /* @param managed_priority  The Java priority for which we want the niceness value. */      \\\n101:   /* @param result  A pointer to an int in which to store the niceness result. */             \\\n102:   /* @return PALETTE_STATUS_OK if the call succeeded. */                                      \\\n103:   /*         PALETTE_STATUS_INVALID_ARGUMENT if the argument is not a valid Java priority. */ \\\n104:   M(PaletteMapPriority, int32_t managed_priority, /*out*/ int* result)\n105: \n106: #endif  // ART_LIBARTPALETTE_INCLUDE_PALETTE_PALETTE_METHOD_LIST_H_"}

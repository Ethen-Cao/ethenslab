_ART_COMPILATION_FILTER_VERIFY;\n48:             case \"space-profile\" ->\n49:                 ArtStatsLog\n50:                         .ART_DEX2_OAT_REPORTED__COMPILER_FILTER__ART_COMPILATION_FILTER_SPACE_PROFILE;\n51:             case \"space\" ->\n52:                 ArtStatsLog.ART_DEX2_OAT_REPORTED__COMPILER_FILTER__ART_COMPILATION_FILTER_SPACE;\n53:             case \"speed-profile\" ->\n54:                 ArtStatsLog\n55:                         .ART_DEX2_OAT_REPORTED__COMPILER_FILTER__ART_COMPILATION_FILTER_SPEED_PROFILE;\n56:             case \"speed\" ->\n57:                 ArtStatsLog.ART_DEX2_OAT_REPORTED__COMPILER_FILTER__ART_COMPILATION_FILTER_SPEED;\n58:             case \"everything-profile\" ->\n59:                 ArtStatsLog\n60:                         .ART_DEX2_OAT_REPORTED__COMPILER_FILTER__ART_COMPILATION_FILTER_EVERYTHING_PROFILE;\n61:             case \"everything\" ->\n62:                 ArtStatsLog\n63:                         .ART_DEX2_OAT_REPORTED__COMPILER_FILTER__ART_COMPILATION_FILTER_EVERYTHING;\n64:             case \"skip\" ->\n65:                 ArtStatsLog.ART_DEX2_OAT_REPORTED__COMPILER_FILTER__ART_COMPILATION_FILTER_SKIP;\n66:             default ->\n67:                 ArtStatsLog.ART_DEX2_OAT_REPORTED__COMPILER_FILTER__ART_COMPILATION_FILTER_UNKNOWN;\n68:         };\n69:     }\n70: \n71:     private static int translateCompilationReason(String compilationReason) {\n72:         return switch (compilationReason) {\n73:             case ReasonMapping.REASON_FIRST_BOOT ->\n74:                 ArtStatsLog\n75:                         .ART_DEX2_OAT_REPORTED__COMPILATION_REASON__ART_COMPILATION_REASON_FIRST_BOOT;\n76:             case ReasonMapping.REASON_BOOT_AFTER_OTA ->\n77:                 ArtStatsLog\n78:                         .ART_DEX2_OAT_REPORTED__COMPILATION_REASON__ART_COMPILATION_REASON_BOOT_AFTER_OTA;\n79:             case ReasonMapping.REASON_BOOT_AFTER_MAINLINE_UPDATE ->\n80:                 ArtStatsLog\n81:                         .ART_DEX2_OAT_REPORTED__COMPILATION_REASON__ART_COMPILATION_REASON_BOOT_AFTER_MAINLINE_UPDATE;\n82:             case ReasonMapping.REASON_INSTALL ->\n83:                 ArtStatsLog\n84:                         .ART_DEX2_OAT_REPORTED__COMPILATION_REASON__ART_COMPILATION_REASON_INSTALL;\n85:             case ReasonMapping.REASON_BG_DEXOPT ->\n86:                 ArtStatsLog\n87:                         .ART_DEX2_OAT_REPORTED__COMPILATION_REASON__ART_COMPILATION_REASON_BG_DEXOPT;\n88:             case ReasonMapping.REASON_CMDLINE ->\n89:                 ArtStatsLog\n90:                         .ART_DEX2_OAT_REPORTED__COMPILATION_REASON__ART_COMPILATION_REASON_CMDLINE;\n91:             case ReasonMapping.REASON_INACTIVE ->\n92:                 ArtStatsLog\n93:                         .ART_DEX2_OAT_REPORTED__COMPILATION_REASON__ART_COMPILATION_REASON_INACTIVE;\n94:             case ReasonMapping.REASON_PRE_REBOOT_DEXOPT ->\n95:                 ArtStatsLog\n96:                         .ART_DEX2_OAT_REPORTED__COMPILATION_REASON__ART_COMPILATION_REASON_AB_OTA;\n97:             case ReasonMapping.REASON_INSTALL_FAST ->\n98:                 ArtStatsLog\n99:                         .ART_DEX2_OAT_REPORTED__COMPILATION_REASON__ART_COMPILATION_REASON_INSTALL_FAST;\n100:             case ReasonMapping.REASON_INSTALL_BULK ->\n101:                 ArtStatsLog\n102:                         .ART_DEX2_OAT_REPORTED__COMPILATION_REASON__ART_COMPILATION_REASON_INSTALL_BULK;\n103:             case ReasonMapping.REASON_INSTALL_BULK_SECONDARY ->\n104:                 ArtStatsLog\n105:                         .ART_DEX2_OAT_REPORTED__COMPILATION_REASON__ART_COMPILATION_REASON_INSTALL_BULK_SECONDARY;\n106:             case ReasonMapping.REASON_INSTALL_BULK_DOWNGRADED ->\n107:                 ArtStatsLog\n108:                         .ART_DEX2_OAT_REPORTED__COMPILATION_REASON__ART_COMPILATION_REASON_INSTALL_BULK_DOWNGRADED;\n109:             case ReasonMapping.REASON_INSTALL_BULK_SECONDARY_DOWNGRADED ->\n110:                 ArtStatsLog\n111:                         .ART_DEX2_OAT_REPORTED__COMPILATION_REASON__ART_COMPILATION_REASON_INSTALL_BULK_SECONDARY_DOWNGRADED;\n112:             default ->\n113:                 ArtStatsLog\n114:                         .ART_DEX2_OAT_REPORTED__COMPILATION_REASON__ART_COMPILATION_REASON_UNKNOWN;\n115:         };\n116:     }\n117: \n118:     private static int translateIsa(String isa) {\n119:         return switch (isa) {\n120:             case \"arm\" -> ArtStatsLog.ART_DEX2_OAT_REPORTED__ISA__ART_ISA_ARM;\n121:             case \"arm64\" -> ArtStatsLog.ART_DEX2_OAT_REPORTED__ISA__ART_ISA_ARM64;\n122:             case \"riscv64\" -> ArtStatsLog.ART_DEX2_OAT_REPORTED__ISA__ART_ISA_RISCV64;\n123:             case \"x86\" -> ArtStatsLog.ART_DEX2_OAT_REPORTED__ISA__ART_ISA_X86;\n124:             case \"x86_64\" -> ArtStatsLog.ART_DATUM_DELTA_REPORTED__ISA__ART_ISA_X86_64;\n125:             default -> ArtStatsLog.ART_DEX2_OAT_REPORTED__ISA__ART_ISA_UNKNOWN;\n126:         };\n127:     }\n128: \n129:     private static int translateDexMetadataType(@DexMetadata.Type int dexMetadataType) {\n130:         return switch (dexMetadataType) {\n131:             case DexMetadata.TYPE_PROFILE ->\n132:                 ArtStatsLog.ART_DEX2_OAT_REPORTED__DEX_METADATA_TYPE__ART_DEX_METADATA_TYPE_PROFILE;\n133:             case DexMetadata.TYPE_VDEX ->\n134:                 ArtStatsLog.ART_DEX2_OAT_REPORTED__DEX_METADATA_TYPE__ART_DEX_METADATA_TYPE_VDEX;\n135:             case DexMetadata.TYPE_PROFILE_AND_VDEX ->\n136:                 ArtStatsLog\n137:                         .ART_DEX2_OAT_REPORTED__DEX_METADATA_TYPE__ART_DEX_METADATA_TYPE_PROFILE_AND_VDEX;\n138:             case DexMetadata.TYPE_NONE ->\n139:                 ArtStatsLog.ART_DEX2_OAT_REPORTED__DEX_METADATA_TYPE__ART_DEX_METADATA_TYPE_NONE;\n140:             case DexMetadata.TYPE_ERROR ->\n141:                 ArtStatsLog.ART_DEX2_OAT_REPORTED__DEX_METADATA_TYPE__ART_DEX_METADATA_TYPE_ERROR;\n142:             case DexMetadata.TYPE_UNKNOWN ->\n143:                 ArtStatsLog.ART_DEX2_OAT_REPORTED__DEX_METADATA_TYPE__ART_DEX_METADATA_TYPE_UNKNOWN;\n144:             default ->\n145:                 ArtStatsLog.ART_DEX2_OAT_REPORTED__DEX_METADATA_TYPE__ART_DEX_METADATA_TYPE_UNKNOWN;\n146:         };\n147:     }\n148: \n149:     private static int getApkType(DetailedDexInfo dexInfo) {\n150:         if (dexInfo instanceof PrimaryDexUtils.PrimaryDexInfo primaryDexInfo) {\n151:             return primaryDexInfo.splitName() == null\n152:                     ? ArtStatsLog.ART_DEX2_OAT_REPORTED__APK_TYPE__ART_APK_TYPE_BASE\n153:                     : ArtStatsLog.ART_DEX2_OAT_REPORTED__APK_TYPE__ART_APK_TYPE_SPLIT;\n154:         } else if (dexInfo instanceof DexUseManagerLocal.CheckedSecondaryDexInfo) {\n155:             return ArtStatsLog.ART_DEX2_OAT_REPORTED__APK_TYPE__ART_APK_TYPE_SECONDARY;\n156:         }\n157:         return ArtStatsLog.ART_DEX2_OAT_REPORTED__APK_TYPE__ART_APK_TYPE_UNKNOWN;\n158:     }\n159: \n160:     public static class Session {\n161:         private final int mAppId;\n162:         private final DexMetadataHelper.DexMetadataInfo mDmInfo;\n163:         private final DetailedDexInfo mDexInfo;\n164:         private String mCompilerFilter;\n165:         private final String mCompilationReason;\n166:         private final List<Abi> mAbis;\n167: \n168:         private boolean mIsEnabled = true;\n169:         private final Map<Abi, Result> mResultsToRecord = new HashMap<>();\n170: \n171:         public Session(int appId, @NonNull DexMetadataHelper.DexMetadataInfo dmInfo,\n172:                 @NonNull DetailedDexInfo dexInfo, @NonNull String compilerFilter,\n173:                 @NonNull String compilationReason, @NonNull List<Abi> abis) {\n174:             mAppId = appId;\n175:             mDmInfo = dmInfo;\n176:             mDexInfo = dexInfo;\n177:             mCompilerFilter = compilerFilter;\n178:             mCompilationReason = compilationReason;\n179:             mAbis = new ArrayList<>(abis);\n180: \n181:             // By default, set the results for all ABIs to \"Not Run\"\n182:             for (Abi abi : abis) {\n183:                 mResultsToRecord.put(abi,\n184:                         new Result(\n185:                                 Dex2OatResult.notRun(), 0L /* sizeBytes */, 0L /* wallTimeMs */));\n186:             }\n187:         }\n188: \n189:         public void disable() {\n190:             mIsEnabled = false;\n191:         }\n192: \n193:         public void setCompilerFilter(@NonNull String compilerFilter) {\n194:             mCompilerFilter = compilerFilter;\n195:         }\n196: \n197:         public void recordResultForAbi(\n198:                 @NonNull Abi abi, @NonNull Dex2OatResult result, long sizeBytes, long wallTimeMs) {\n199:             mResultsToRecord.replace(abi, new Result(result, sizeBytes, wallTimeMs));\n200:             mAbis.remove(abi);\n201:         }\n202: \n203:         public void recordResultForRemainingAbis(@NonNull Dex2OatResult result) {\n204:             for (Abi abi : mAbis) {\n205:                 mResultsToRecord.replace(\n206:                         abi, new Result(result, 0L /* sizeBytes */, 0L /* wallTimeMs */));\n207:             }\n208:             mAbis.clear();\n209:         }\n210: \n211:         public void report() {\n212:             if (!mIsEnabled) {\n213:                 return;\n214:             }\n215: \n216:             for (Map.Entry<Abi, Result> entry : mResultsToRecord.entrySet()) {\n217:                 Abi abi = entry.getKey();\n218:                 Result result = entry.getValue();\n219:                 ArtStatsLog.write(ArtStatsLog.ART_DEX2OAT_REPORTED, mAppId,\n220:                         translateCompilerFilter(mCompilerFilter),\n221:                         translateCompilationReason(mCompilationReason),\n222:                         translateDexMetadataType(mDmInfo.type()), getApkType(mDexInfo),\n223:                         translateIsa(abi.isa()), result.dex2OatResult.status,\n224:                         result.dex2OatResult.exitCode, result.dex2OatResult.signal,\n225:                         (int) (result.sizeBytes / 1024), (int) result.wallTimeMs);\n226:             }\n227:         }\n228: \n229:         public record Result(Dex2OatResult dex2OatResult, long sizeBytes, long wallTimeMs) {}\n230:     }\n231: \n232:     public record Dex2OatResult(int status, int exitCode, int signal) {\n233:         public static Dex2OatResult notRun() {\n234:             return baseResultWithStatus(\n235:                     ArtStatsLog.ART_DEX2_OAT_REPORTED__RESULT_STATUS__EXEC_RESULT_STATUS_NOT_RUN);\n236:         }\n237: \n238:         public static Dex2OatResult exited(int exitCode) {\n239:             return new Dex2OatResult(\n240:                     ArtStatsLog.ART_DEX2_OAT_REPORTED__RESULT_STATUS__EXEC_RESULT_STATUS_EXITED,\n241:                     exitCode, 0 /* signal */);\n242:         }\n243: \n244:         public static Dex2OatResult cancelled() {\n245:             return baseResultWithStatus(\n246:                     ArtStatsLog.ART_DEX2_OAT_REPORTED__RESULT_STATUS__EXEC_RESULT_STATUS_CANCELLED);\n247:         }\n248: \n249:         public static Dex2OatResult failedToStart() {\n250:             return baseResultWithStatus(ArtStatsLog\n251:                             .ART_DEX2_OAT_REPORTED__RESULT_STATUS__EXEC_RESULT_STATUS_START_FAILED);\n252:         }\n253: \n254:         private static Dex2OatResult baseResultWithStatus(int status) {\n255:             return new Dex2OatResult(status, -1 /* exitCode */, 0 /* signal */);\n256:         }\n257:     }\n258: }"}

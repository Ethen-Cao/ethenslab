rter::~MetricsReporter() { MaybeStopBackgroundThread(); }\n50: \n51: void MetricsReporter::ReloadConfig(const ReportingConfig& config) {\n52:   DCHECK(!thread_.has_value()) << \"The config cannot be reloaded after the background \"\n53:                                   \"reporting thread is started.\";\n54:   config_ = config;\n55: }\n56: \n57: bool MetricsReporter::IsMetricsReportingEnabled(const SessionData& session_data) const {\n58:   return session_data.session_id % config_.reporting_num_mods < config_.reporting_mods;\n59: }\n60: \n61: bool MetricsReporter::MaybeStartBackgroundThread(SessionData session_data) {\n62:   CHECK(!thread_.has_value());\n63: \n64:   session_data_ = session_data;\n65:   LOG_STREAM(DEBUG) << \"Received session metadata: \" << session_data_.session_id;\n66: \n67:   if (!IsMetricsReportingEnabled(session_data_)) {\n68:     return false;\n69:   }\n70: \n71:   thread_.emplace(&MetricsReporter::BackgroundThreadRun, this);\n72:   return true;\n73: }\n74: \n75: void MetricsReporter::MaybeStopBackgroundThread() {\n76:   if (thread_.has_value()) {\n77:     messages_.SendMessage(ShutdownRequestedMessage{});\n78:     thread_->join();\n79:     thread_.reset();\n80:   }\n81: }\n82: \n83: void MetricsReporter::NotifyStartupCompleted() {\n84:   if (ShouldReportAtStartup() && thread_.has_value()) {\n85:     messages_.SendMessage(StartupCompletedMessage{});\n86:   }\n87: }\n88: \n89: void MetricsReporter::NotifyAppInfoUpdated(AppInfo* app_info) {\n90:   std::string compilation_reason;\n91:   std::string compiler_filter;\n92: \n93:   app_info->GetPrimaryApkOptimizationStatus(\n94:       &compiler_filter, &compilation_reason);\n95: \n96:   SetCompilationInfo(\n97:       CompilationReasonFromName(compilation_reason),\n98:       CompilerFilterReportingFromName(compiler_filter));\n99: }\n100: \n101: void MetricsReporter::RequestMetricsReport(bool synchronous) {\n102:   if (thread_.has_value()) {\n103:     messages_.SendMessage(RequestMetricsReportMessage{synchronous});\n104:     if (synchronous) {\n105:       thread_to_host_messages_.ReceiveMessage();\n106:     }\n107:   }\n108: }\n109: \n110: void MetricsReporter::SetCompilationInfo(CompilationReason compilation_reason,\n111:                                          CompilerFilterReporting compiler_filter) {\n112:   if (thread_.has_value()) {\n113:     messages_.SendMessage(CompilationInfoMessage{compilation_reason, compiler_filter});\n114:   }\n115: }\n116: \n117: void MetricsReporter::BackgroundThreadRun() {\n118:   LOG_STREAM(DEBUG) << \"Metrics reporting thread started\";\n119: \n120:   // AttachCurrentThread is needed so we can safely use the ART concurrency primitives within the\n121:   // messages_ MessageQueue.\n122:   const bool attached = runtime_->AttachCurrentThread(kBackgroundThreadName,\n123:                                                       /*as_daemon=*/true,\n124:                                                       runtime_->GetSystemThreadGroup(),\n125:                                                       /*create_peer=*/true);\n126: \n127:   if (attached) {\n128:     // Mark it as rutime thread so we won't report it via jvmti.\n129:     Thread::Current()->SetIsRuntimeThread(true);\n130:   }\n131: \n132:   bool running = true;\n133: \n134:   // Configure the backends\n135:   if (config_.dump_to_logcat) {\n136:     backends_.emplace_back(new LogBackend(std::make_unique<TextFormatter>(), LogSeverity::INFO));\n137:   }\n138:   if (config_.dump_to_file.has_value()) {\n139:     std::unique_ptr<MetricsFormatter> formatter;\n140:     if (config_.metrics_format == \"xml\") {\n141:       formatter = std::make_unique<XmlFormatter>();\n142:     } else {\n143:       formatter = std::make_unique<TextFormatter>();\n144:     }\n145: \n146:     backends_.emplace_back(new FileBackend(std::move(formatter), config_.dump_to_file.value()));\n147:   }\n148:   if (config_.dump_to_statsd) {\n149:     auto backend = CreateStatsdBackend();\n150:     if (backend != nullptr) {\n151:       backends_.emplace_back(std::move(backend));\n152:     }\n153:   }\n154: \n155:   MaybeResetTimeout();\n156: \n157:   while (running) {\n158:     messages_.SwitchReceive(\n159:         [&]([[maybe_unused]] ShutdownRequestedMessage message) {\n160:           LOG_STREAM(DEBUG) << \"Shutdown request received \" << session_data_.session_id;\n161:           running = false;\n162: \n163:           ReportMetrics();\n164:         },\n165:         [&](RequestMetricsReportMessage message) {\n166:           LOG_STREAM(DEBUG) << \"Explicit report request received \" << session_data_.session_id;\n167:           ReportMetrics();\n168:           if (message.synchronous) {\n169:             thread_to_host_messages_.SendMessage(ReportCompletedMessage{});\n170:           }\n171:         },\n172:         [&]([[maybe_unused]] TimeoutExpiredMessage message) {\n173:           LOG_STREAM(DEBUG) << \"Timer expired, reporting metrics \" << session_data_.session_id;\n174: \n175:           ReportMetrics();\n176:           MaybeResetTimeout();\n177:         },\n178:         [&]([[maybe_unused]] StartupCompletedMessage message) {\n179:           LOG_STREAM(DEBUG) << \"App startup completed, reporting metrics \"\n180:               << session_data_.session_id;\n181:           ReportMetrics();\n182:           startup_reported_ = true;\n183:           MaybeResetTimeout();\n184:         },\n185:         [&](CompilationInfoMessage message) {\n186:           LOG_STREAM(DEBUG) << \"Compilation info received \" << session_data_.session_id;\n187:           session_data_.compilation_reason = message.compilation_reason;\n188:           session_data_.compiler_filter = message.compiler_filter;\n189: \n190:           UpdateSessionInBackends();\n191:         });\n192:   }\n193: \n194:   if (attached) {\n195:     runtime_->DetachCurrentThread();\n196:   }\n197:   LOG_STREAM(DEBUG) << \"Metrics reporting thread terminating \" << session_data_.session_id;\n198: }\n199: \n200: void MetricsReporter::MaybeResetTimeout() {"}

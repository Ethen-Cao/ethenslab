espace art HIDDEN {\n56: \n57: static void DumpCmdLine(std::ostream& os) {\n58: #if defined(__linux__)\n59:   // Show the original command line, and the current command line too if it's changed.\n60:   // On Android, /proc/self/cmdline will have been rewritten to something like \"system_server\".\n61:   // Note: The string \"Cmd line:\" is chosen to match the format used by debuggerd.\n62:   std::string current_cmd_line;\n63:   if (android::base::ReadFileToString(\"/proc/self/cmdline\", &current_cmd_line)) {\n64:     current_cmd_line.resize(current_cmd_line.find_last_not_of('\\0') + 1);  // trim trailing '\\0's\n65:     std::replace(current_cmd_line.begin(), current_cmd_line.end(), '\\0', ' ');\n66: \n67:     os << \"Cmd line: \" << current_cmd_line << \"\\n\";\n68:     const char* stashed_cmd_line = GetCmdLine();\n69:     if (stashed_cmd_line != nullptr && current_cmd_line != stashed_cmd_line\n70:             && strcmp(stashed_cmd_line, \"<unset>\") != 0) {\n71:       os << \"Original command line: \" << stashed_cmd_line << \"\\n\";\n72:     }\n73:   }\n74: #else\n75:   os << \"Cmd line: \" << GetCmdLine() << \"\\n\";\n76: #endif\n77: }\n78: \n79: SignalCatcher::SignalCatcher()\n80:     : lock_(\"SignalCatcher lock\"),\n81:       cond_(\"SignalCatcher::cond_\", lock_),\n82:       thread_(nullptr) {\n83:   SetHaltFlag(false);\n84: \n85:   // Create a raw pthread; its start routine will attach to the runtime.\n86:   CHECK_PTHREAD_CALL(pthread_create, (&pthread_, nullptr, &Run, this), \"signal catcher thread\");\n87: \n88:   Thread* self = Thread::Current();\n89:   MutexLock mu(self, lock_);\n90:   while (thread_ == nullptr) {\n91:     cond_.Wait(self);\n92:   }\n93: }\n94: \n95: SignalCatcher::~SignalCatcher() {\n96:   // Since we know the thread is just sitting around waiting for signals\n97:   // to arrive, send it one.\n98:   SetHaltFlag(true);\n99:   CHECK_PTHREAD_CALL(pthread_kill,\n100:                      (pthread_, SIGQUIT),\n101:                      android::base::StringPrintf(\"signal catcher shutdown: %lu\", pthread_));\n102:   CHECK_PTHREAD_CALL(pthread_join,\n103:                      (pthread_, nullptr),\n104:                      android::base::StringPrintf(\"signal catcher shutdown: %lu\", pthread_));\n105: }\n106: \n107: void SignalCatcher::SetHaltFlag(bool new_value) {\n108:   MutexLock mu(Thread::Current(), lock_);\n109:   halt_ = new_value;\n110: }\n111: \n112: bool SignalCatcher::ShouldHalt() {\n113:   MutexLock mu(Thread::Current(), lock_);\n114:   return halt_;\n115: }\n116: \n117: void SignalCatcher::Output(const std::string& s) {\n118:   ScopedThreadStateChange tsc(Thread::Current(), ThreadState::kWaitingForSignalCatcherOutput);\n119:   palette_status_t status = PaletteWriteCrashThreadStacks(s.data(), s.size());\n120:   if (status == PALETTE_STATUS_OK) {\n121:     LOG(INFO) << \"Wrote stack traces to tombstoned\";\n122:   } else {\n123:     CHECK(status == PALETTE_STATUS_FAILED_CHECK_LOG);\n124:     LOG(ERROR) << \"Failed to write stack traces to tombstoned\";\n125:   }\n126: }\n127: \n128: void SignalCatcher::HandleSigQuit() {\n129:   sigquit_nanotime_ = NanoTime();\n130:   Runtime* runtime = Runtime::Current();\n131:   std::ostringstream os;\n132:   os << \"\\n\"\n133:       << \"----- pid \" << getpid() << \" at \" << GetIsoDate() << \" -----\\n\";\n134: \n135:   DumpCmdLine(os);\n136: \n137:   // Note: The strings \"Build fingerprint:\" and \"ABI:\" are chosen to match the format used by\n138:   // debuggerd. This allows, for example, the stack tool to work.\n139:   std::string fingerprint = runtime->GetFingerprint();\n140:   os << \"Build fingerprint: '\" << (fingerprint.empty() ? \"unknown\" : fingerprint) << \"'\\n\";\n141:   os << \"ABI: '\" << GetInstructionSetString(runtime->GetInstructionSet()) << \"'\\n\";\n142: \n143:   os << \"Build type: \" << (kIsDebugBuild ? \"debug\" : \"optimized\") << \"\\n\";\n144: \n145:   os << \"Debug Store: \" << DebugStoreGetString() << \"\\n\";\n146: \n147:   if (ShouldEnableProfileCode()) {\n148:     std::string str = TraceProfiler::GetLongRunningMethodsString();\n149:     if (!str.empty()) {\n150:       os << \"LongRunningMethods: \" << str << \"\\n\";\n151:     }\n152:   }\n153: \n154:   runtime->DumpForSigQuit(os);\n155: \n156:   if ((false)) {\n157:     std::string maps;\n158:     if (android::base::ReadFileToString(\"/proc/self/maps\", &maps)) {\n159:       os << \"/proc/self/maps:\\n\" << maps;\n160:     }\n161:   }\n162:   os << \"----- end \" << getpid() << \" -----\\n\";\n163:   Output(os.str());\n164:   sigquit_nanotime_ = std::nullopt;\n165: }\n166: \n167: void SignalCatcher::HandleMultiplexedSigUsr1(siginfo_t* info) {\n168:   if (info->si_code != SI_QUEUE) {\n169:     // If this signal is not generated from sigqueue, fallback to forcing a GC trigger.\n170:     HandleSigUsr1();\n171:     return;\n172:   }\n173:   // Use the signal's tag to call the correct handler.\n174:   uint8_t tag = std::bit_cast<uintptr_t>(info->si_value) & 0xFu;\n175:   switch (tag) {\n176:     case 0:\n177:       HandleLongMethodTracing(info);\n178:       break;\n179:     default:\n180:       LOG(WARNING) << \"SIGUSR1 received via sigqueue with unknown tag: \" << static_cast<int>(tag);\n181:       break;\n182:   }\n183: }\n184: \n185: void SignalCatcher::HandleSigUsr1() {\n186:   LOG(INFO) << \"SIGUSR1 forcing GC (no HPROF) and profile save\";\n187:   Runtime::Current()->GetHeap()->CollectGarbage(/* clear_soft_references= */ false);\n188:   ProfileSaver::ForceProcessProfiles();\n189: }\n190: \n191: void SignalCatcher::HandleLongMethodTracing(siginfo_t* info) {\n192:   if (info == nullptr) {\n193:     // The signaler didn't attach a duration, treat this case as a no-op.\n194:     return;\n195:   }\n196: \n197:   // Extract duration from the signal info\n198:   // si_value.sival_int contains the integer passed with the signal\n199:   // This value represent the trace duration in ms\n200:   // It is safe to ignore the tag here as we durations that are divisible by 16\n201:   uint64_t duration_ms = static_cast<uint64_t>(info->si_value.sival_int);\n202: \n203:   LOG(INFO) << \"Received SIGUSR1 signal with long method tracing tag, enabling long method tracing\"\n204:             << \" for duration :\" << duration_ms << \" millis\";\n205:   // Start the long method tracing with the specified duration (in nanoseconds)\n206:   TraceProfiler::StartTraceLongRunningMethods(duration_ms * 1000000ULL);\n207: }\n208: \n209: int SignalCatcher::WaitForSignal(Thread* self, SignalSet& signals, siginfo_t* info) {\n210:   ScopedThreadStateChange tsc(self, ThreadState::kWaitingInMainSignalCatcherLoop);\n211: \n212:   // Signals for sigwait() must be blocked but not ignored.  We\n213:   // block signals like SIGQUIT for all threads, so the condition\n214:   // is met.  When the signal hits, we wake up, without any signal\n215:   // handlers being invoked.\n216:   int signal_number = signals.Wait(info);\n217:   if (!ShouldHalt()) {\n218:     // Let the user know we got the signal, just in case the system's too screwed for us to\n219:     // actually do what they want us to do...\n220:     LOG(INFO) << *self << \": reacting to signal \" << signal_number;"}

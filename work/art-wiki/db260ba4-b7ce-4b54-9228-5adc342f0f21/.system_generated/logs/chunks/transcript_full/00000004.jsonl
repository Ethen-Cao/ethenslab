ner << \"\\n\"\n2549:        << \"ThreadList lock owner tid: \" << thread_list_lock_owner << \"\\n\"\n2550:        << \"ClassLinker classes lock owner tid: \" << classes_lock_owner << \"\\n\"\n2551:        << \"ClassLinker dex lock owner tid: \" << dex_lock_owner << \"\\n\";\n2552:   }\n2553: }\n2554: \n2555: void Runtime::SetStatsEnabled(bool new_state) {\n2556:   Thread* self = Thread::Current();\n2557:   MutexLock mu(self, *Locks::instrument_entrypoints_lock_);\n2558:   if (new_state == true) {\n2559:     GetStats()->Clear(~0);\n2560:     // TODO: wouldn't it make more sense to clear _all_ threads' stats?\n2561:     self->GetStats()->Clear(~0);\n2562:     if (stats_enabled_ != new_state) {\n2563:       GetInstrumentation()->InstrumentQuickAllocEntryPointsLocked();\n2564:     }\n2565:   } else if (stats_enabled_ != new_state) {\n2566:     GetInstrumentation()->UninstrumentQuickAllocEntryPointsLocked();\n2567:   }\n2568:   stats_enabled_ = new_state;\n2569: }\n2570: \n2571: void Runtime::ResetStats(int kinds) {\n2572:   GetStats()->Clear(kinds & 0xffff);\n2573:   // TODO: wouldn't it make more sense to clear _all_ threads' stats?\n2574:   Thread::Current()->GetStats()->Clear(kinds >> 16);\n2575: }\n2576: \n2577: uint64_t Runtime::GetStat(int kind) {\n2578:   RuntimeStats* stats;\n2579:   if (kind < (1<<16)) {\n2580:     stats = GetStats();\n2581:   } else {\n2582:     stats = Thread::Current()->GetStats();\n2583:     kind >>= 16;\n2584:   }\n2585:   switch (kind) {"}

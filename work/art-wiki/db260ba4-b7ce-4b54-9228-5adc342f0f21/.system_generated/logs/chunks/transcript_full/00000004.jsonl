ocal;\n40: \n41: import java.io.File;\n42: import java.io.FileInputStream;\n43: import java.io.FileNotFoundException;\n44: import java.io.FileOutputStream;\n45: import java.io.IOException;\n46: import java.io.InputStream;\n47: import java.io.OutputStream;\n48: import java.nio.file.Files;\n49: import java.nio.file.StandardCopyOption;\n50: import java.util.HashSet;\n51: import java.util.List;\n52: import java.util.Objects;\n53: import java.util.Set;\n54: import java.util.concurrent.CompletableFuture;\n55: import java.util.concurrent.Executor;\n56: import java.util.concurrent.ForkJoinPool;\n57: import java.util.function.Function;\n58: \n59: /**\n60:  * A helper class to report the Pre-reboot Dexopt metrics to StatsD.\n61:  *\n62:  * This class is not thread-safe.\n63:  *\n64:  * During Pre-reboot Dexopt, both the old version and the new version of this code is run. The old\n65:  * version writes to disk first, and the new version writes to disk later. After reboot, the new\n66:  * version loads from disk.\n67:  *\n68:  * @hide\n69:  */\n70: @RequiresApi(Build.VERSION_CODES.UPSIDE_DOWN_CAKE)\n71: public class PreRebootStatsReporter {\n72:     // Shorthands for those ultra long names in the stats proto generated code.\n73:     public static final int END_STATUS_UNSPECIFIED =\n74:             ArtStatsLog.PRE_REBOOT_DEXOPT_JOB_ENDED__ARTIFACTS_END_STATUS__END_STATUS_UNSPECIFIED;\n75:     public static final int END_STATUS_COMMITTED =\n76:             ArtStatsLog.PRE_REBOOT_DEXOPT_JOB_ENDED__ARTIFACTS_END_STATUS__END_STATUS_COMMITTED;\n77:     public static final int END_STATUS_MISSING =\n78:             ArtStatsLog.PRE_REBOOT_DEXOPT_JOB_ENDED__ARTIFACTS_END_STATUS__END_STATUS_MISSING;\n79:     public static final int END_STATUS_ERROR =\n80:             ArtStatsLog.PRE_REBOOT_DEXOPT_JOB_ENDED__ARTIFACTS_END_STATUS__END_STATUS_ERROR;\n81:     public static final int END_STATUS_EXPIRED =\n82:             ArtStatsLog.PRE_REBOOT_DEXOPT_JOB_ENDED__ARTIFACTS_END_STATUS__END_STATUS_EXPIRED;\n83:     public static final int END_STATUS_OBSOLETE =\n84:             ArtStatsLog.PRE_REBOOT_DEXOPT_JOB_ENDED__ARTIFACTS_END_STATUS__END_STATUS_OBSOLETE;\n85:     public static final int END_STATUS_SUPERSEDED =\n86:             ArtStatsLog.PRE_REBOOT_DEXOPT_JOB_ENDED__ARTIFACTS_END_STATUS__END_STATUS_SUPERSEDED;\n87: \n88:     private static final String FILENAME = \"/data/system/pre-reboot-stats.pb\";\n89: \n90:     @NonNull private final Injector mInjector;\n91: \n92:     public PreRebootStatsReporter() {\n93:         this(new Injector());\n94:     }\n95: \n96:     /** @hide */\n97:     @VisibleForTesting\n98:     public PreRebootStatsReporter(@NonNull Injector injector) {\n99:         mInjector = injector;\n100:     }\n101: \n102:     public void recordJobScheduled(boolean isAsync, boolean isOtaUpdate) {\n103:         PreRebootStats.Builder statsBuilder = PreRebootStats.newBuilder();\n104:         statsBuilder.setStatus(Status.STATUS_SCHEDULED)\n105:                 .setJobType(isOtaUpdate ? JobType.JOB_TYPE_OTA : JobType.JOB_TYPE_MAINLINE);\n106:         // Omit job_scheduled_timestamp_millis to indicate a synchronous job.\n107:         if (isAsync) {\n108:             statsBuilder.setJobScheduledTimestampMillis(mInjector.getCurrentTimeMillis());\n109:         }\n110:         save(statsBuilder);\n111:     }\n112: \n113:     public void recordJobNotScheduled(@NonNull Status reason, boolean isOtaUpdate) {\n114:         Utils.check(reason == Status.STATUS_NOT_SCHEDULED_DISABLED\n115:                 || reason == Status.STATUS_NOT_SCHEDULED_JOB_SCHEDULER);\n116:         PreRebootStats.Builder statsBuilder = PreRebootStats.newBuilder();\n117:         statsBuilder.setStatus(reason).setJobType(\n118:                 isOtaUpdate ? JobType.JOB_TYPE_OTA : JobType.JOB_TYPE_MAINLINE);\n119:         save(statsBuilder);\n120:     }\n121: \n122:     public void recordJobStarted() {\n123:         PreRebootStats.Builder statsBuilder = load();\n124:         if (statsBuilder.getStatus() == Status.STATUS_UNKNOWN) {\n125:             // Failed to load, the error is already logged.\n126:             return;\n127:         }\n128: \n129:         JobRun.Builder runBuilder =\n130:                 JobRun.newBuilder().setJobStartedTimestampMillis(mInjector.getCurrentTimeMillis());\n131:         statsBuilder.setStatus(Status.STATUS_STARTED)\n132:                 .clearFailureReason()\n133:                 .addJobRuns(runBuilder)\n134:                 .setSkippedPackageCount(0)\n135:                 .setOptimizedPackageCount(0)\n136:                 .setFailedPackageCount(0)\n137:                 .setTotalPackageCount(0)\n138:                 // Some packages may have artifacts from a previously cancelled job, but we count\n139:                 // from scratch for simplicity.\n140:                 .setPackagesWithArtifactsBeforeRebootCount(0);\n141:         save(statsBuilder);\n142:     }\n143: \n144:     public class ProgressSession {\n145:         private @NonNull PreRebootStats.Builder mStatsBuilder = load();\n146: \n147:         public void recordProgress(int skippedPackageCount, int optimizedPackageCount,\n148:                 int failedPackageCount, int totalPackageCount,\n149:                 int packagesWithArtifactsBeforeRebootCount) {\n150:             if (mStatsBuilder.getStatus() == Status.STATUS_UNKNOWN) {\n151:                 // Failed to load, the error is already logged.\n152:                 return;\n153:             }\n154: \n155:             mStatsBuilder.setSkippedPackageCount(skippedPackageCount)\n156:                     .setOptimizedPackageCount(optimizedPackageCount)\n157:                     .setFailedPackageCount(failedPackageCount)\n158:                     .setTotalPackageCount(totalPackageCount)\n159:                     .setPackagesWithArtifactsBeforeRebootCount(\n160:                             packagesWithArtifactsBeforeRebootCount);"}

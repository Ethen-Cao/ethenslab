tionLogEntry> entries_;\n95:   const char* log_path_;\n96: };\n97: \n98: }  // namespace odrefresh\n99: }  // namespace art\n100: \n101: #endif  // ART_ODREFRESH_ODR_COMPILATION_LOG_H_"}

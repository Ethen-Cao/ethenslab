:     Append4LE(thread_header + 1, it.first);\n214:     Append2LE(thread_header + 5, it.second.length());\n215:     os.write(reinterpret_cast<char*>(thread_header), kAlwaysOnThreadInfoHeaderSize);\n216:     os.write(it.second.c_str(), it.second.length());\n217:   }\n218: \n219:   // Dump data about method information.\n220:   for (ArtMethod* method : traced_methods) {","truncated_fields":["content"]}

e->NotifyStartupCompleted()) {\n50:     // Maybe generate a runtime app image. If the runtime is debuggable, boot\n51:     // classpath classes can be dynamically changed, so don't bother generating an\n52:     // image.\n53:     if (!runtime->IsJavaDebu\n<truncated 1016 bytes>\ne2(\"Delete thread pool\");\n75:   Runtime::Current()->DeleteThreadPool();\n76: }\n77: \n78: void StartupCompletedTask::DeleteStartupDexCaches(Thread* self, bool called_by_gc) {\n79:   VLOG(startup) << \"StartupCompletedTask running\";\n80:   Runtime* const runtime = Runtime::Current();\n81: \n82:   ScopedTrace trace(\"Releasing dex caches and app image spaces metadata\");\n83: \n84:   static struct EmptyClosure : Closure {\n85:     void Run([[maybe_unused]] Thread* thread) override {}\n86:   } closure;\n87: \n88:   // Fetch the startup linear alloc so no other thread tries to allocate there.\n89:   std::unique_ptr<LinearAlloc> startup_linear_alloc(runtime->ReleaseStartupLinearAlloc());\n90:   // No thread could be allocating arrays or accessing dex caches when this\n91:   // thread has mutator-lock held exclusively.\n92:   bool run_checkpoints = !Locks::mutator_lock_->IsExclusiveHeld(self);\n93: \n94:   // Request a checkpoint to make sure all threads see we have started up and\n95:   // won't allocate in the startup linear alloc. Without this checkpoint what\n96:   // could happen is (T0 == self):\n97:   // 1) T1 fetches startup alloc, allocates an array there.\n98:   // 2) T0 goes over the dex caches, clear dex cache arrays in the startup alloc.\n99:   // 3) T1 sets the dex cache array from startup alloc in a dex cache.\n100:   // 4) T0 releases startup alloc.\n101:   //\n102:   // With this checkpoint, 3) cannot happen as T0 waits for T1 to reach the\n103:   // checkpoint.\n104:   if (run_checkpoints) {\n105:     runtime->GetThreadList()->RunCheckpoint(&closure);\n106:   }\n107: \n108:   {\n109:     UnlinkStartupDexCacheVisitor visitor;\n110:     ReaderMutexLock mu(self, *Locks::dex_lock_);\n111:     runtime->GetClassLinker()->VisitDexCaches(&visitor);\n112:   }\n113: \n114: \n115:   // Request a checkpoint to make sure no threads are:\n116:   // - accessing the image space metadata section when we madvise it\n117:   // - accessing dex caches when we free them\n118:   if (run_checkpoints) {\n119:     runtime->GetThreadList()->RunCheckpoint(&closure);\n120:   }","truncated_fields":["content"]}
{"step_index":138,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-26T01:31:18Z","input_tokens":6177,"cache_read_tokens":221512,"output_tokens":16894,"content":"基于对 [art](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art) 目录源码的核查，该仓库对应 **Android 15/16 主线级 ART 模块**（[palette_method_list.h](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/libartpalette/include/palette/palette_method_list.h#L80-L104) 已演进至 SDK 36.1 接口，[art-flags.aconfig](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/build/flags/art-flags.aconfig#L110-L117) 包含 `art_service_v3`）。其运行时与编译器核心保持**标准上游 AOSP 实现**，未内置高通 `perf_lock` 或车机私有业务插桩（平台侧扩展统一通过 [`libartpalette`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/libartpalette/include/palette/palette_method_list.h#L28-L104) 桥接）。\n\nART 在源码层面围绕 **App 性能** 与 **App 稳定性** 构建了完整的监测、采样、告警与故障取证体系，具体实现如下：\n\n---\n\n## 一、 App 性能监测机制（Performance Monitoring）\n\n### 1. 运行时遥测指标体系（ART Metrics -> Statsd / Logcat / File）\n* **采集指标（48 项）**：[`metrics.h`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/libartbase/base/metrics/metrics.h#L43-L98) 定义了 28 项事件指标（`ART_EVENT_METRICS`）与 20 项周期增量指标（`ART_VALUE_METRICS`），覆盖：\n  * **类加载与校验**：`ClassLoadingTotalTime`、`ClassVerificationCount`、`ClassVerificationTotalTime`。\n  * **JIT 编译**：`JitMethodCompileCount`、`JitMethodCompileTotalTime`。\n  * **GC 吞吐与停顿**：STW 停顿均值/总计（`WorldStopTimeDuringGCAvg`、`GcWorldStopTime`、`GcWorldStopCount`）、Young/Full GC 次数、耗时直方图、扫描/释放字节数、吞吐率，以及并发 GC 期间业务线程慢路径耗时（`AppSlowPathDuringYoungGcDurationDelta` / `AppSlowPathDuringFullGcDurationDelta`）。\n* **采样与上报**：[`MetricsReporter`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/metrics/reporter.cc#L57\n<truncated 19463 bytes>\n/voyah/projects/8397/code/qssi/art/runtime/hidden_api.cc#L627-L753) 监测反射/JNI/链接期对灰黑名单 API 的调用，输出 Logcat 告警、按采样率写入 EventLog（`VMRuntime.hiddenApiUsed`）并回调 `nonSdkApiUsageConsumer`，结合 [`CompatFramework`](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/runtime/compat_framework.h) 阻断越权调用；[art-rw-flags.aconfig](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/build/flags/art-rw-flags.aconfig#L106-L122) 同时提供非只读动态代码加载（DCL）的日志上报与异常拦截开关。\n\n---\n\n## 三、 常用调试属性与开启方式速查\n\n| 监测维度 | 关键属性 / 启动参数 | 默认阈值 / 行为 |\n| :--- | :--- | :--- |\n| **慢 GC / 停顿日志** | `-XX:LongPauseLogThreshold=<ms>` / `-XX:LongGCLogThreshold=<ms>` | 前台 STW `>= 5ms` 或总耗时 `> 100ms` 打 Logcat |\n| **锁竞争释放后采样** | `dalvik.vm.lockprof.threshold` / `-Xstackdumplockprofthreshold:<ms>` | 按耗时比例写 `dvm_lock_sample`；`> 100ms` 打警告 |\n| **锁阻塞实时抓栈** | `-XX:MonitorTimeoutEnable=true` + `debug.art.monitor.app=true` | 阻塞每满 `500ms`（200~999ms）抓持锁线程栈（最多 5 次） |\n| **低开销长方法追踪** | `dalvik.vm.allow_profile_code=true` + `sigqueue(SIGUSR1)` | 捕获 `> ~341ms` 方法并在 `SIGQUIT` 输出 `LongRunningMethods` |\n| **OOM 自动堆转储** | `-XX:PerfettoHprof=true` + `traced.oome_heap_session.count` | OOM 抛出前触发 `\"android.java_hprof.oom\"` 抓堆 |\n| **Java 堆分配采样** | `-XX:PerfettoJavaHeapStackProf=true`（`heapprofd` `\"com.android.art\"`） | 默认 `4KB` 采样间隔动态收缩 TLAB 上报分配栈 |\n| **JNI 检查与泄漏追踪** | `debug.checkjni=1` / `-XX:GlobalRefAllocStackTraceLimit=<N>` | Critical 锁 `> 16ms` 告警；GlobalRef 余量 `< N` 记录分配栈 |\n| **ART 遥测指标导出** | `-Xmetrics-write-to-logcat:true` / `dalvik.vm.metrics.*` | 默认 `2%` 会话上报 Statsd，可强制开启输出至 Logcat/文件 |","thinking":"Complete mapping of all application performance and stability monitoring mechanisms within the specified code directory is now available. This involved a source-verified assessment of all elements. Carefully reviewing guidelines related to specific outputs and communication style will be undertaken.\n\n\nThe question calls for a direct, readable response, suggesting a direct answer is appropriate instead of creating an artifact. However, the guidelines also emphasize avoiding summarization of artifact contents, leading to a need to assess whether an artifact would improve readability. Considering the nature of the technical question, a direct response in chat appears to be the most suitable approach.\n\n\nDirect chat response will be structured using markdown for readability, including code-style formatting and clickable links where appropriate to enhance user experience. The format aims for conciseness and clarity, as per guidelines. Mechanisms, thresholds, triggers, and output channels will be clearly categorized.\n\n\nThe initial assessment reveals the codebase resides within the [art](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art) directory, with a specific commit (`9a380e42`) representing the Android 15/16 Mainline ART module architecture. A key file, [palette_method_list.h](file:///home/ethen/workspace/voyah/projects/8397/code/qssi/art/libartpalette/include/palette/palette_method_list.h#L80-L104), signifies an evolution to SDK 36/36.1 interfaces. The structure of this response will include an overview and then a direct response.\n\n\nThe core runtime and compiler are based on a clean AOSP implementation, without vendor-specific instrumentation.  Platform extensions utilize a bridging mechanism.  App performance monitoring encompasses runtime telemetry via metrics that output to statsd, logcat, and files. The metrics are defined within `ArtMetrics`.\n\n\nMetrics collection focuses on runtime performance data. There are event metrics and value metrics. These encompass aspects like class loading, JIT compila\n<truncated 7688 bytes>\nssed to the next signal handler in the chain.\n\nOOM diagnosis triggers an automatic Perfetto heap dump before the `OutOfMemoryError` is thrown, by invoking `OutOfMemoryErrorHook()` to call `DumpPerfettoOutOfMemory()`.\n\n\nOOM scenarios trigger Perfetto heap dumps before exception throwing. Diagnostics pinpoint heap exhaustion, large object fragmentation, or insufficient free space after Full GC to prevent thrashing.\n\nFinalizer timeouts (default 10s) are exposed for `FinalizerWatchdogDaemon` to detect and terminate processes in `finalize()` deadlocks. CheckJNI validates JNI calls in real-time for thread state, pending exceptions, reference issues, and string encoding violations.\n\n\nJNI critical section violations are detected during array/string access, issuing a warning if the lock exceeds a threshold. Fatal violations trigger an abort with stack trace information.\n\nJNI calls can be traced by specified class or third-party libraries using a command line flag. Indirect and local reference tables are limited to prevent overflows.\n\nReference table overflows trigger aggregated statistics and allocation stack traces for leaks.\n\n\nHeap corruption detection dumps detailed information, including object metadata and memory contents, upon finding invalid references, followed by program termination. Compilation watchdogs prevent indefinite restarts by monitoring compilation progress and implementing timeouts. Global reference allocation stack tracing activates when the number of available slots falls below a defined threshold.\n\n\nSystem-server watchdog now kills itself 10 minutes before PackageManagerService to prevent cascading failures.  Failed `odrefresh` attempts employ exponential backoff with a maximum delay of 12h * 2^N to avoid bootloops.\n\nRestricted API access via reflection, JNI, and linking is intercepted; violations generate logcat warnings, sampled EventLog reports (`VMRuntime.hiddenApiUsed`), and call the registered consumer. High-risk calls are rejected based on `targetSdkVersion` and `CompatFramework` policies.\n\n\n","truncated_fields":["content","thinking"]}

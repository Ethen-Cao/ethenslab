+#pragma once
+
+#include <SkRRect.h>
+#include <SkRect.h>
+#include <SkRefCnt.h>
+#include <SkShader.h>
+
+#include <optional>
+
+class SkCanvas;
+
+namespace android::renderengine::skia {
+
+/**
+ * Creates a device-space Gaussian coverage shader for a simple rounded rectangle.
+ *
+ * Where an arc joins a straight edge, the exact tangency retains analytic one-pixel box coverage.
+ * Over the first two device pixels of arc, reconstruction changes smoothly to a Gaussian of the
+ * requested sigma. Ovals have no straight join and use Gaussian coverage around the full contour.
+ * This attenuates shallow-angle staircase runs without moving the 50% contour. Very small or
+ * ill-conditioned transformed corners return no shader and use the caller's existing fallback.
+ */
+class RoundedCornerShaderFactory {
+public:
+    struct Shader {
+        sk_sp<SkShader> shader;
+        // Conservative local-space bounds containing every non-zero coverage fragment.
+        SkRect drawBounds;
+    };
+
+    std::optional<Shader> createShader(SkCanvas* canvas, const SkRRect& roundedRect,
+                                       float arcSigmaPx) const;
+};
+
+} // namespace android::renderengine::skia

+#include "RoundedCornerShaderFactory.h"
+
+#include <SkCanvas.h>
+#include <SkMatrix.h>
+#include <SkRRect.h>
+#include <SkRuntimeEffect.h>
+#include <SkString.h>
+#include <log/log.h>
+
+#include <cmath>
+#include <utility>
+
+namespace android::renderengine::skia {
+
+namespace {
+
+const SkString kEffectSource_RoundedCornerCoverageEffect(R"(
+    uniform float2 u_stretchFactor;
+    uniform float2x2 u_deviceDerivatives;
+    uniform float2 u_maxSampleRadius;
+    uniform float2 u_axisDeviceSize;
+    uniform float2 u_tangencyHasStraightEdge;
+    uniform float u_arcSigma;
+
+    // Area of an axis-aligned destination pixel cut by the locally linearized edge. The signed
+    // distance is positive outside, and normal is the outward device-space unit normal.
+    float pixelBoxCoverage(float signedDistance, float2 normal) {
+        float2 halfProjection = 0.5 * abs(normal);
+        float a = max(halfProjection.x, halfProjection.y);
+        float b = min(halfProjection.x, halfProjection.y);
+        float z = -signedDistance;
+
+        if (b <= 1e-5) {
+            return saturate((z + a) / max(2.0 * a, 1e-5));
+        }
+        if (z <= -a - b) {
+            return 0.0;
+        }
+        if (z < -a + b) {
+            float t = z + a + b;
+            return t * t / (8.0 * a * b);
+        }
+        if (z <= a - b) {
+            return (z + a) / (2.0 * a);
+        }
+        if (z < a + b) {
+            float t = a + b - z;
+            return 1.0 - t * t / (8.0 * a * b);
+        }
+        return 1.0;
+    }
+
+    // Winitzki's approximation. Its maximum absolute error is small enough to remain below one
+    // 8-bit coverage level, while avoiding a sampled lookup texture in this hot path.
+    float erfApprox(float x) {
+        float xSquared = x * x;
+        float exponent =
+                -xSquared * (1.27323954474 + 0.147 * xSquared) /
+                (1.0 + 0.147 * xSquared);
+        return sign(x) * sqrt(max(1.0 - exp(exponent), 0.0));
+    }
+
+    float gaussianCoverage(float signedDistance) {
+        float support = 3.0 * u_arcSigma;
+        if (signedDistance <= -support) {
+            return 1.0;
+        }
+        if (signedDistance >= support) {
+            return 0.0;
+        }
+        float normalizedDistance = signedDistance / (1.41421356237 * u_arcSigma);
+        return 0.5 * (1.0 - erfApprox(normalizedDistance));
+    }
+
+    half4 main(float2 xy) {
+        float2 rawCorner = abs(xy) + u_stretchFactor;
+
+        // Bound the three-sigma footprint in normalized corner coordinates. Almost every fragment
+        // of a large freeform layer returns through one of these coherent branches.
+        float2 outerCorner = max(rawCorner + u_maxSampleRadius, float2(0.0));
+        if (dot(outerCorner, outerCorner) <= 1.0) {
+            return half4(1.0);
+        }
+        float2 innerCorner = max(rawCorner - u_maxSampleRadius, float2(0.0));
+        if (dot(innerCorner, innerCorner) >= 1.0) {
+            return half4(0.0);
+        }
+
+        float2 corner = max(rawCorner, float2(0.0));
+        float radiusSquared = dot(corner, corner);
+        if (radiusSquared <= 1e-8) {
+            return half4(1.0);
+        }
+
+        // U = 2 * device-to-normalized-corner Jacobian. Include the derivative of abs(xy), which
+        // matters for rotated/sheared RRects even though it cancels for axis-aligned scaling.
+        float2 cornerSign = sign(xy);
+        float2 gradient = (corner * cornerSign) * u_deviceDerivatives;
+        float gradientLength = length(gradient);
+        if (gradientLength <= 1e-6) {
+            return half4(radiusSquared <= 1.0 ? 1.0 : 0.0);
+        }
+        float2 normal = gradient / gradientLength;
+
+        // Find the intersection of the ellipse with a ray along the device-space edge normal.
+        // Unlike f/fwidth, this yields a distance in destination pixels and remains stable when
+        // the same device geometry is represented by a different affine layer transform.
+        float2 activeAxis =
+                float2(rawCorner.x > 0.0 ? 1.0 : 0.0,
+                       rawCorner.y > 0.0 ? 1.0 : 0.0);
+        float2 normalStep =
+                0.5 * (u_deviceDerivatives * normal) * cornerSign * activeAxis;
+        float implicitEdge = radiusSquared - 1.0;
+        float quadraticA = dot(normalStep, normalStep);
+        float quadraticB = dot(corner, normalStep);
+        float discriminant =
+                max(quadraticB * quadraticB - quadraticA * implicitEdge, 0.0);
+        float signedDistance =
+                implicitEdge /
+                max(quadraticB + sqrt(discriminant), 1e-6);
+
+        // Where a straight edge exists, keep ordinary one-pixel area coverage at the exact arc
+        // tangency. Change to the Gaussian over two destination pixels of arc length so both the
+        // value and first derivative stay continuous at the join. Ovals have no straight join and
+        // therefore select Gaussian coverage around their full contour.
+        float2 cornerDirection = corner / sqrt(radiusSquared);
+        float2 distanceFromTangency = cornerDirection * u_axisDeviceSize;
+        float2 tangencyMix =
+                smoothstep(float2(0.0), float2(2.0), distanceFromTangency);
+        tangencyMix =
+                mix(float2(1.0), tangencyMix, u_tangencyHasStraightEdge);
+        float arcMix = min(tangencyMix.x, tangencyMix.y);
+        float coverage =
+                mix(pixelBoxCoverage(signedDistance, normal),
+                    gaussianCoverage(signedDistance), arcMix);
+        return half4(saturate(coverage));
+    }
+)");
+
+const sk_sp<SkRuntimeEffect>& getRoundedCornerCoverageEffect() {
+    // Keep this experimental effect out of RuntimeEffectManager's eager startup path. A SkSL
+    // incompatibility must never prevent RenderEngine (and therefore SurfaceFlinger) from
+    // starting. Function-local static initialization is thread-safe and also ensures an error is
+    // logged only once; a null result makes every later call use the existing rounded-corner path.
+    static const sk_sp<SkRuntimeEffect> effect = [] {
+        SkRuntimeEffect::Options options;
+        options.fName = "RE_RoundedCornerCoverageEffect";
+        auto [effect, error] =
+                SkRuntimeEffect::MakeForShader(kEffectSource_RoundedCornerCoverageEffect, options);
+        if (!effect) {
+            ALOGE("Rounded-corner coverage effect construction failed; using existing path: %s",
+                  error.c_str());
+        }
+        return effect;
+    }();
+    return effect;
+}
+
+} // namespace
+
+std::optional<RoundedCornerShaderFactory::Shader> RoundedCornerShaderFactory::createShader(
+        SkCanvas* canvas, const SkRRect& roundedRect, float arcSigmaPx) const {
+    if (!canvas || !std::isfinite(arcSigmaPx) || arcSigmaPx < 0.5f || arcSigmaPx > 2.0f ||
+        (!roundedRect.isSimple() && !roundedRect.isOval())) {
+        return std::nullopt;
+    }
+
+    const SkRect& rect = roundedRect.rect();
+    const SkVector radii = roundedRect.getSimpleRadii();
+    if (rect.isEmpty() || !rect.isFinite() || radii.fX <= 0.0f || radii.fY <= 0.0f ||
+        !std::isfinite(radii.fX) || !std::isfinite(radii.fY)) {
+        return std::nullopt;
+    }
+
+    const SkMatrix& canvasMatrix = canvas->getTotalMatrix();
+    if (canvasMatrix.hasPerspective()) {
+        return std::nullopt;
+    }
+
+    const float a = canvasMatrix.getScaleX();
+    const float b = canvasMatrix.getSkewX();
+    const float c = canvasMatrix.getSkewY();
+    const float d = canvasMatrix.getScaleY();
+    const float determinant = a * d - b * c;
+    if (!std::isfinite(a) || !std::isfinite(b) || !std::isfinite(c) || !std::isfinite(d) ||
+        !std::isfinite(determinant) || std::abs(determinant) < 1e-6f) {
+        return std::nullopt;
+    }
+
+    const float filterSupportPx = 3.0f * arcSigmaPx;
+
+    // The normal-ray intersection below is effectively exact for circles and well-conditioned
+    // transformed ellipses. Fall back to Skia when a highly eccentric/sheared ellipse makes that
+    // ray a poor signed-distance approximation. Small physical corners also fall back: if the
+    // complete Gaussian support reaches the ellipse center, its normal is undefined and a
+    // distance-only reconstruction would need a separate small-shape convolution.
+    const float axisX = radii.fX * std::hypot(a, c);
+    const float axisY = radii.fY * std::hypot(b, d);
+    const float axisDot = radii.fX * radii.fY * (a * b + c * d);
+    const float trace = axisX * axisX + axisY * axisY;
+    const float eigenvalueDifference = std::hypot(axisX * axisX - axisY * axisY, 2.0f * axisDot);
+    const float maxEigenvalue = 0.5f * (trace + eigenvalueDifference);
+    const float ellipseDeterminant = std::abs(determinant) * radii.fX * radii.fY;
+    if (!std::isfinite(maxEigenvalue) || !std::isfinite(ellipseDeterminant) ||
+        maxEigenvalue <= 0.0f || ellipseDeterminant <= 0.0f) {
+        return std::nullopt;
+    }
+    const float conditionNumber = maxEigenvalue / ellipseDeterminant;
+    const float minDeviceSemiAxis = ellipseDeterminant / std::sqrt(maxEigenvalue);
+    if (!std::isfinite(conditionNumber) || !std::isfinite(minDeviceSemiAxis) ||
+        conditionNumber > 4.0f || minDeviceSemiAxis < filterSupportPx) {
+        return std::nullopt;
+    }
+
+    const float stretchX = 1.0f - rect.width() * 0.5f / radii.fX;
+    const float stretchY = 1.0f - rect.height() * 0.5f / radii.fY;
+    if (!std::isfinite(stretchX) || !std::isfinite(stretchY)) {
+        return std::nullopt;
+    }
+
+    const sk_sp<SkRuntimeEffect>& effect = getRoundedCornerCoverageEffect();
+    if (!effect) {
+        return std::nullopt;
+    }
+
+    SkRuntimeShaderBuilder builder(effect);
+    builder.uniform("u_stretchFactor") = SkV2{stretchX, stretchY};
+
+    // This is the derivative of x^2 + y^2 - 1 after accounting for both the normalization by
+    // corner radii and the current local-to-device transform. The derivation follows Skia's
+    // ClipSuperRRect runtime-shader implementation.
+    const float dx = 2.0f / (radii.fX * determinant);
+    const float dy = 2.0f / (radii.fY * determinant);
+    if (!std::isfinite(dx) || !std::isfinite(dy)) {
+        return std::nullopt;
+    }
+    builder.uniform("u_deviceDerivatives") = SkV4{d * dx, -c * dy, -b * dx, a * dy};
+    const float axisDeviceSizeX = axisX;
+    const float axisDeviceSizeY = axisY;
+    if (!std::isfinite(axisDeviceSizeX) || !std::isfinite(axisDeviceSizeY) ||
+        axisDeviceSizeX <= 0.0f || axisDeviceSizeY <= 0.0f) {
+        return std::nullopt;
+    }
+    builder.uniform("u_axisDeviceSize") = SkV2{axisDeviceSizeX, axisDeviceSizeY};
+    builder.uniform("u_tangencyHasStraightEdge") =
+            SkV2{rect.width() > 2.0f * radii.fX ? 1.0f : 0.0f,
+                 rect.height() > 2.0f * radii.fY ? 1.0f : 0.0f};
+
+    const float inverseAbsDeterminant = 1.0f / std::abs(determinant);
+    const float maxSampleRadiusX =
+            filterSupportPx * std::hypot(d, b) * inverseAbsDeterminant / radii.fX;
+    const float maxSampleRadiusY =
+            filterSupportPx * std::hypot(c, a) * inverseAbsDeterminant / radii.fY;
+    if (!std::isfinite(maxSampleRadiusX) || !std::isfinite(maxSampleRadiusY)) {
+        return std::nullopt;
+    }
+    builder.uniform("u_maxSampleRadius") = SkV2{maxSampleRadiusX, maxSampleRadiusY};
+    builder.uniform("u_arcSigma") = arcSigmaPx;
+
+    SkMatrix cornerToLocal;
+    cornerToLocal.setScaleTranslate(radii.fX, radii.fY, rect.centerX(), rect.centerY());
+    sk_sp<SkShader> shader = builder.makeShader(&cornerToLocal);
+    if (!shader) {
+        return std::nullopt;
+    }
+
+    // Convert the three-sigma device-space support to conservative local X/Y outsets.
+    const float bloatX = std::hypot(d, b) * inverseAbsDeterminant * filterSupportPx;
+    const float bloatY = std::hypot(c, a) * inverseAbsDeterminant * filterSupportPx;
+    if (!std::isfinite(bloatX) || !std::isfinite(bloatY)) {
+        return std::nullopt;
+    }
+
+    const SkRect drawBounds = rect.makeOutset(bloatX, bloatY);
+    if (!drawBounds.isFinite()) {
+        return std::nullopt;
+    }
+
+    return Shader{.shader = std::move(shader), .drawBounds = drawBounds};
+}
+
+} // namespace android::renderengine::skia

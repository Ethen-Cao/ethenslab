+TEST_P(RenderEngineTest, drawLayers_roundedCornerUsesGaussianArcCoverage) {
+    if (!GetParam()->apiSupported()) {
+        GTEST_SKIP();
+    }
+    if (!base::GetBoolProperty(PROPERTY_DEBUG_RENDERENGINE_ENHANCED_ROUNDED_CORNER_AA, true)) {
+        GTEST_SKIP() << "Enhanced rounded-corner AA is disabled by debug property";
+    }
+    constexpr int kExpectedAaSigmaX100 = 100;
+    if (base::GetIntProperty<int>(PROPERTY_DEBUG_RENDERENGINE_ROUNDED_CORNER_AA_SIGMA_X100,
+                                  kExpectedAaSigmaX100) != kExpectedAaSigmaX100) {
+        GTEST_SKIP() << "Coverage thresholds require the default 1.00px Gaussian sigma";
+    }
+    initializeRenderEngine();
+
+    renderengine::DisplaySettings settings;
+    settings.physicalDisplay = fullscreenRect();
+    settings.clip = fullscreenRect();
+    settings.outputDataspace = ui::Dataspace::V0_SRGB_LINEAR;
+
+    constexpr int kLeft = 8;
+    constexpr int kTop = 8;
+    constexpr int kRight = 120;
+    constexpr int kBottom = 120;
+    constexpr int kRadius = 50;
+
+    renderengine::LayerSettings layer;
+    layer.sourceDataspace = ui::Dataspace::V0_SRGB_LINEAR;
+    layer.geometry.boundaries = FloatRect(kLeft, kTop, kRight, kBottom);
+    layer.geometry.roundedCornersRadii = gui::CornerRadii(kRadius);
+    layer.geometry.roundedCornersCrop = layer.geometry.boundaries;
+    layer.source.solidColor = half3(1.0f, 0.0f, 0.0f);
+    layer.alpha = 1.0f;
+
+    invokeDraw(settings, {layer});
+    const std::vector<uint8_t> alpha = copyBufferAlpha();
+    ASSERT_EQ(static_cast<size_t>(DEFAULT_DISPLAY_WIDTH * DEFAULT_DISPLAY_HEIGHT), alpha.size());
+
+    const auto alphaAt = [&alpha](int x, int y) {
+        return alpha[static_cast<size_t>(y * DEFAULT_DISPLAY_WIDTH + x)];
+    };
+
+    // The straight edge keeps an approximately one-pixel transition.
+    EXPECT_LE(alphaAt(DEFAULT_DISPLAY_WIDTH / 2, kTop - 1), 2);
+    EXPECT_GE(alphaAt(DEFAULT_DISPLAY_WIDTH / 2, kTop), 253);
+
+    // A one-pixel Gaussian sigma provides several independently quantized transition pixels at
+    // every arc angle. This is intentionally wider than Skia's regular one-pixel RRect AA: a
+    // high-luminance layer behind a dark window otherwise exposes shallow-angle alpha steps.
+    size_t partialPixels = 0;
+    std::array<size_t, 3> coverageBands = {};
+    for (int y = kTop; y < kTop + kRadius; y++) {
+        for (int x = kLeft; x < kLeft + kRadius; x++) {
+            const uint8_t value = alphaAt(x, y);
+            if (value > 0 && value < 255) {
+                partialPixels++;
+            }
+            if (value >= 8 && value <= 79) {
+                coverageBands[0]++;
+            } else if (value >= 80 && value <= 175) {
+                coverageBands[1]++;
+            } else if (value >= 176 && value <= 247) {
+                coverageBands[2]++;
+            }
+        }
+    }
+    EXPECT_GE(partialPixels, 330u);
+    EXPECT_LE(partialPixels, 430u);
+    EXPECT_GE(coverageBands[0], 65u);
+    EXPECT_GE(coverageBands[1], 60u);
+    EXPECT_GE(coverageBands[2], 80u);
+
+    // Reference values from the device-space signed-distance Gaussian. They span three coverage
+    // bands at shallow and diagonal portions of the arc instead of collapsing into long runs.
+    EXPECT_NEAR(62, alphaAt(27, 17), 8);
+    EXPECT_NEAR(193, alphaAt(28, 18), 8);
+    EXPECT_NEAR(176, alphaAt(23, 22), 8);
+
+    // The same analytic equation must produce symmetric coverage at all four corners.
+    int maxSymmetryDifference = 0;
+    for (int y = 0; y < kRadius; y++) {
+        for (int x = 0; x < kRadius; x++) {
+            const int topLeft = alphaAt(kLeft + x, kTop + y);
+            maxSymmetryDifference = std::max(maxSymmetryDifference,
+                                             std::abs(topLeft - alphaAt(kRight - 1 - x, kTop + y)));
+            maxSymmetryDifference =
+                    std::max(maxSymmetryDifference,
+                             std::abs(topLeft - alphaAt(kLeft + x, kBottom - 1 - y)));
+            maxSymmetryDifference =
+                    std::max(maxSymmetryDifference,
+                             std::abs(topLeft - alphaAt(kRight - 1 - x, kBottom - 1 - y)));
+            maxSymmetryDifference = std::max(maxSymmetryDifference,
+                                             std::abs(topLeft - alphaAt(kLeft + y, kTop + x)));
+        }
+    }
+    EXPECT_LE(maxSymmetryDifference, 2);
+}

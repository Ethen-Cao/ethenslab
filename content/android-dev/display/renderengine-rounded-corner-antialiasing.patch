+TEST_P(RenderEngineTest, drawLayers_roundedCornerGaussianIsStableAcrossSubpixelPhases) {
+    if (!GetParam()->apiSupported()) {
+        GTEST_SKIP();
+    }
+    if (!base::GetBoolProperty(PROPERTY_DEBUG_RENDERENGINE_ENHANCED_ROUNDED_CORNER_AA, true)) {
+        GTEST_SKIP() << "Enhanced rounded-corner AA is disabled by debug property";
+    }
+    constexpr int kExpectedAaSigmaX100 = 100;
+    if (base::GetIntProperty<int>(PROPERTY_DEBUG_RENDERENGINE_ROUNDED_CORNER_AA_SIGMA_X100,
+                                  kExpectedAaSigmaX100) != kExpectedAaSigmaX100) {
+        GTEST_SKIP() << "Coverage reference requires the default 1.00px Gaussian sigma";
+    }
+    initializeRenderEngine();
+
+    renderengine::DisplaySettings settings;
+    settings.physicalDisplay = fullscreenRect();
+    settings.clip = fullscreenRect();
+    settings.outputDataspace = ui::Dataspace::V0_SRGB_LINEAR;
+
+    renderengine::LayerSettings layer;
+    layer.sourceDataspace = ui::Dataspace::V0_SRGB_LINEAR;
+    layer.source.solidColor = half3(1.0f, 0.0f, 0.0f);
+    layer.alpha = 1.0f;
+
+    constexpr float kLeft = 14.0f;
+    constexpr float kTop = 14.0f;
+    constexpr float kDiameter = 100.0f;
+    constexpr float kRadius = kDiameter * 0.5f;
+    constexpr float kInverseSqrtTwo = 0.70710678118f;
+    constexpr std::array<float, 4> kPhases = {0.0f, 0.25f, 0.5f, 0.75f};
+
+    size_t sampleCount = 0;
+    double totalError = 0.0;
+    float maxError = 0.0f;
+    for (const float phaseY : kPhases) {
+        for (const float phaseX : kPhases) {
+            layer.geometry.boundaries =
+                    FloatRect(kLeft + phaseX, kTop + phaseY,
+                              kLeft + phaseX + kDiameter, kTop + phaseY + kDiameter);
+            layer.geometry.roundedCornersRadii = gui::CornerRadii(kRadius);
+            layer.geometry.roundedCornersCrop = layer.geometry.boundaries;
+
+            invokeDraw(settings, {layer});
+            const std::vector<uint8_t> alpha = copyBufferAlpha();
+            ASSERT_EQ(static_cast<size_t>(DEFAULT_DISPLAY_WIDTH * DEFAULT_DISPLAY_HEIGHT),
+                      alpha.size());
+
+            const float centerX = kLeft + phaseX + kRadius;
+            const float centerY = kTop + phaseY + kRadius;
+            size_t phaseSampleCount = 0;
+            double phaseTotalError = 0.0;
+            float phaseMaxError = 0.0f;
+            for (int y = 8; y < 70; y++) {
+                for (int x = 8; x < 70; x++) {
+                    const float dx = static_cast<float>(x) + 0.5f - centerX;
+                    const float dy = static_cast<float>(y) + 0.5f - centerY;
+                    if (dx > 0.0f || dy > 0.0f) {
+                        continue;
+                    }
+
+                    const float signedDistance = std::hypot(dx, dy) - kRadius;
+                    const float distanceFromTangency = std::min(-dx, -dy);
+                    if (std::abs(signedDistance) > 2.5f || distanceFromTangency < 3.0f) {
+                        continue;
+                    }
+
+                    const float expected =
+                            0.5f * std::erfc(signedDistance * kInverseSqrtTwo);
+                    const float actual =
+                            alpha[static_cast<size_t>(y * DEFAULT_DISPLAY_WIDTH + x)] / 255.0f;
+                    const float error = std::abs(actual - expected);
+                    maxError = std::max(maxError, error);
+                    totalError += error;
+                    sampleCount++;
+                    phaseMaxError = std::max(phaseMaxError, error);
+                    phaseTotalError += error;
+                    phaseSampleCount++;
+                }
+            }
+            ASSERT_GE(phaseSampleCount, 340u);
+            EXPECT_LE(phaseMaxError, 0.015f) << "phase " << phaseX << ", " << phaseY;
+            EXPECT_LE(phaseTotalError / static_cast<double>(phaseSampleCount), 0.004)
+                    << "phase " << phaseX << ", " << phaseY;
+        }
+    }
+
+    ASSERT_GE(sampleCount, 5500u);
+    EXPECT_LE(maxError, 0.015f);
+    EXPECT_LE(totalError / static_cast<double>(sampleCount), 0.004);
+}

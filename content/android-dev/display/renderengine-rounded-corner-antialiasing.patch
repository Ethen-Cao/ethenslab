+        GTEST_SKIP() << "Enhanced rounded-corner AA is disabled by debug property";
+    }
+    constexpr int kExpectedAaSigmaX100 = 100;
+    if (base::GetIntProperty<int>(PROPERTY_DEBUG_RENDERENGINE_ROUNDED_CORNER_AA_SIGMA_X100,
+                                  kExpectedAaSigmaX100) != kExpectedAaSigmaX100) {
+        GTEST_SKIP() << "Color reference requires the default 1.00px Gaussian sigma";
+    }
+    initializeRenderEngine();
+
+    renderengine::DisplaySettings settings;
+    settings.physicalDisplay = fullscreenRect();
+    settings.clip = fullscreenRect();
+    settings.outputDataspace = ui::Dataspace::V0_SRGB;
+
+    renderengine::LayerSettings background;
+    background.sourceDataspace = ui::Dataspace::V0_SRGB;
+    background.geometry.boundaries = fullscreenRect().toFloatRect();
+    background.source.solidColor = half3(139.0f / 255.0f, 191.0f / 255.0f, 239.0f / 255.0f);
+    background.alpha = 1.0f;
+
+    renderengine::LayerSettings foreground;
+    foreground.sourceDataspace = ui::Dataspace::V0_SRGB;
+    foreground.geometry.boundaries = FloatRect(14.5f, 14.5f, 114.5f, 114.5f);
+    foreground.geometry.roundedCornersRadii = gui::CornerRadii(50.0f);
+    foreground.geometry.roundedCornersCrop = foreground.geometry.boundaries;
+    foreground.source.solidColor = half3(17.0f / 255.0f, 19.0f / 255.0f, 23.0f / 255.0f);
+    foreground.alpha = 1.0f;
+
+    invokeDraw(settings, {background, foreground});
+
+    // This row crosses the arc at a shallow normal (14/50 in X), where a one-pixel AA ramp forms
+    // conspicuous same-color runs over a bright background. Check the full Gaussian transition in
+    // final RGB, not only its 50% point. This intentionally reflects RenderEngine's current sRGB
+    // code-value compositing; a future global linear-light policy should update this reference.
+    constexpr float kCenterX = 64.5f;
+    constexpr float kCenterY = 64.5f;
+    constexpr float kRadius = 50.0f;
+    constexpr float kInverseSqrtTwo = 0.70710678118f;
+    constexpr std::array<float, 3> kForeground = {17.0f, 19.0f, 23.0f};
+    constexpr std::array<float, 3> kBackground = {139.0f, 191.0f, 239.0f};
+    const auto expectedTransition = [=](Point location) {
+        const float dx = static_cast<float>(location.x) + 0.5f - kCenterX;
+        const float dy = static_cast<float>(location.y) + 0.5f - kCenterY;
+        const float signedDistance = std::hypot(dx, dy) - kRadius;
+        const float coverage = 0.5f * std::erfc(signedDistance * kInverseSqrtTwo);
+        const auto blendChannel = [coverage](float foreground, float background) {
+            return static_cast<uint8_t>(
+                    std::lround(coverage * foreground + (1.0f - coverage) * background));
+        };
+        return ubyte4(blendChannel(kForeground[0], kBackground[0]),
+                      blendChannel(kForeground[1], kBackground[1]),
+                      blendChannel(kForeground[2], kBackground[2]), 255);
+    };
+    expectBufferColor(Rect(46, 16, 56, 17), expectedTransition, 3);
+
+    expectBufferColor(Point(64, 64), 17, 19, 23, 255, 2);
+    expectBufferColor(Point(8, 8), 139, 191, 239, 255, 2);
+}
